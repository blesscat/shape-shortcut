---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import '../../../styles/starwind.css'
import { Badge } from '../../../components/starwind/badge'
import { Button } from '../../../components/starwind/button'
import { Card } from '../../../components/starwind/card'
import { Separator } from '../../../components/starwind/separator'
import ModelPreviewPicture from '../../../components/ModelPreviewPicture.astro'
import {
  deskQuickStartEntries,
  type DeskQuickStartRole,
} from '../../../features/docs/desk-system-guide'
import {
  SUPPORTED_LOCALES,
  isLocale,
  translate,
  type Locale,
} from '../../../i18n'
import { localizedCadPathFor, publicPathFor } from '../../../i18n/routes'

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}

const locale = Astro.props.locale as Locale
if (!isLocale(locale)) throw new Error(`UNSUPPORTED_LOCALE:${locale}`)
const t = (key: string) => translate(locale, key)
const quickStartEntries = deskQuickStartEntries(locale)
const deskDiagramPathFor = (name: string) =>
  `/docs/desk-system/${name}.${locale}.svg`
const deskDiagramDarkPathFor = (name: string) =>
  `/docs/desk-system/${name}.${locale}-dark.svg`
function entryFor(role: DeskQuickStartRole) {
  const entry = quickStartEntries.find((candidate) => candidate.role === role)
  if (!entry) throw new Error(`DESK_QUICK_START_ROLE_MISSING:${role}`)
  return entry
}
const boardEntry = entryFor('board')
const snapEntry = entryFor('snap')
const locatingPostEntry = entryFor('locating-post')
const gridBoxEntry = entryFor('grid-box')
const organizerBoxEntry = entryFor('organizer-box')
const roundBoxEntry = entryFor('round-box')
const wallBoardPath = localizedCadPathFor(locale, 'opengrid', 'wall')
const wallSnapPath = localizedCadPathFor(locale, 'opengrid-snap', 'wall')
const wallCoverPath = localizedCadPathFor(locale, 'opengrid-wall-cover', 'wall')
const openConnectShelfPath = localizedCadPathFor(
  locale,
  'opengrid-openconnect-shelf',
)
const openConnectOrganizerPath = localizedCadPathFor(
  locale,
  'opengrid-openconnect-organizer',
)
---

<SiteLayout
  {locale}
  title={`${t('docs.title')} | Shape Shortcut`}
  description={t('docs.description')}
>
  <Card as="article" class="cyber-card grid gap-10 p-5 shadow-lg sm:p-8">
    <header class="grid gap-3">
      <Badge variant="primary" eyebrow size="sm" class="w-fit">
        {t('docs.eyebrow')}
      </Badge>
      <h1 class="text-4xl font-semibold leading-tight">{t('docs.title')}</h1>
    </header>

    <Card
      as="nav"
      size="sm"
      class="grid gap-3 bg-muted p-4"
      aria-label={t('docs.sectionNav')}
      data-testid="docs-section-nav"
    >
      <p class="m-0 font-semibold text-foreground">{t('docs.sectionNav')}</p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a
          class="text-foreground underline underline-offset-4"
          href="#desk-quick-start-title">{t('docs.sectionNav.desk')}</a
        >
        <a
          class="text-foreground underline underline-offset-4"
          href="#docs-wall-system-title">{t('docs.sectionNav.wall')}</a
        >
        <a
          class="text-foreground underline underline-offset-4"
          href="#docs-model-reference-title">{t('docs.sectionNav.models')}</a
        >
        <a
          class="text-foreground underline underline-offset-4"
          href="#docs-reference-title">{t('docs.sectionNav.common')}</a
        >
      </div>
    </Card>
    <Separator class="bg-border" />

    <section
      class="grid gap-8"
      aria-labelledby="desk-quick-start-title"
      data-testid="desk-quick-start"
    >
      <header class="grid gap-3">
        <h2
          class="text-3xl font-semibold leading-tight"
          id="desk-quick-start-title"
        >
          {t('docs.deskQuickStart.title')}
        </h2>
        <p class="max-w-3xl leading-normal">
          {t('docs.deskQuickStart.intro')}
        </p>
      </header>

      <figure class="grid gap-3">
        <ModelPreviewPicture
          class="w-full rounded-xl border border-border bg-muted"
          src={deskDiagramPathFor('desk-system-flow')}
          darkSrc={deskDiagramDarkPathFor('desk-system-flow')}
          width={1400}
          height={820}
          loading="eager"
          alt={t('docs.deskQuickStart.visual.flow.alt')}
        />
        <figcaption class="text-sm text-muted-foreground">
          {t('docs.deskQuickStart.visual.flow.caption')}
        </figcaption>
      </figure>

      <section class="grid gap-4" aria-labelledby="desk-workflow-title">
        <h3 class="text-2xl font-semibold" id="desk-workflow-title">
          {t('docs.deskQuickStart.workflowHeading')}
        </h3>
        <ol class="grid gap-4">
          <Card as="li" size="sm" class="cyber-card p-4" data-step="board">
            <h4 class="font-semibold">
              <a
                class="text-foreground underline underline-offset-4"
                href={boardEntry.href}
                >{t('docs.deskQuickStart.step.board.title')}</a
              >
            </h4>
            <p class="mt-2 leading-normal">
              {t('docs.deskQuickStart.step.board.body')}
            </p>
            <p class="mt-2 text-sm text-muted-foreground">
              {t('docs.deskQuickStart.step.board.note')}
            </p>
          </Card>
          <Card as="li" size="sm" class="cyber-card p-4" data-step="snap">
            <h4 class="font-semibold">
              <a
                class="text-foreground underline underline-offset-4"
                href={snapEntry.href}
                >{t('docs.deskQuickStart.step.snap.title')}</a
              >
            </h4>
            <p class="mt-2 leading-normal">
              {t('docs.deskQuickStart.step.snap.body')}
            </p>
          </Card>
          <Card as="li" size="sm" class="cyber-card p-4" data-step="locating">
            <h4 class="font-semibold">
              {t('docs.deskQuickStart.step.locating.title')}
            </h4>
            <p class="mt-2 leading-normal">
              {t('docs.deskQuickStart.step.locating.body')}
            </p>
          </Card>
          <Card as="li" size="sm" class="cyber-card p-4" data-step="container">
            <h4 class="font-semibold">
              {t('docs.deskQuickStart.step.container.title')}
            </h4>
            <p class="mt-2 leading-normal">
              {t('docs.deskQuickStart.step.container.body')}
            </p>
            <p class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
              <a
                class="text-foreground underline underline-offset-4"
                href={gridBoxEntry.href}>{t(gridBoxEntry.labelKey)}</a
              >
              <a
                class="text-foreground underline underline-offset-4"
                href={organizerBoxEntry.href}>{t(organizerBoxEntry.labelKey)}</a
              >
              <a
                class="text-foreground underline underline-offset-4"
                href={roundBoxEntry.href}>{t(roundBoxEntry.labelKey)}</a
              >
            </p>
          </Card>
        </ol>
      </section>

      <figure class="grid gap-3">
        <ModelPreviewPicture
          class="w-full rounded-xl border border-border bg-muted"
          src={deskDiagramPathFor('desk-system-board-snap')}
          darkSrc={deskDiagramDarkPathFor('desk-system-board-snap')}
          width={1000}
          height={560}
          loading="lazy"
          alt={t('docs.deskQuickStart.visual.placement.alt')}
        />
        <figcaption class="text-sm text-muted-foreground">
          {t('docs.deskQuickStart.visual.placement.caption')}
        </figcaption>
      </figure>

      <section class="grid gap-4" aria-labelledby="desk-locating-title">
        <h3 class="text-2xl font-semibold" id="desk-locating-title">
          {t('docs.deskQuickStart.locatingHeading')}
        </h3>
        <div class="grid gap-4 md:grid-cols-2">
          <Card as="article" size="sm" class="cyber-card grid gap-2 p-4">
            <h4 class="font-semibold">
              <a
                class="text-foreground underline underline-offset-4"
                href={locatingPostEntry.href}
                >{t('docs.deskQuickStart.locating.separate.title')}</a
              >
            </h4>
            <p class="leading-normal">
              {t('docs.deskQuickStart.locating.separate.body')}
            </p>
          </Card>
          <Card as="article" size="sm" class="cyber-card grid gap-2 p-4">
            <h4 class="font-semibold">
              {t('docs.deskQuickStart.locating.builtin.title')}
            </h4>
            <p class="leading-normal">
              {t('docs.deskQuickStart.locating.builtin.body')}
            </p>
            <p class="font-semibold text-muted-foreground">
              {t('docs.deskQuickStart.locating.builtin.noPost')}
            </p>
          </Card>
        </div>
      </section>

      <figure class="grid gap-3">
        <ModelPreviewPicture
          class="w-full rounded-xl border border-border bg-muted"
          src={deskDiagramPathFor('desk-system-locating-options')}
          darkSrc={deskDiagramDarkPathFor('desk-system-locating-options')}
          width={1100}
          height={560}
          loading="lazy"
          alt={t('docs.deskQuickStart.visual.locating.alt')}
        />
        <figcaption class="text-sm text-muted-foreground">
          {t('docs.deskQuickStart.visual.locating.caption')}
        </figcaption>
      </figure>

      <section class="grid gap-4" aria-labelledby="desk-checklist-title">
        <h3 class="text-2xl font-semibold" id="desk-checklist-title">
          {t('docs.deskQuickStart.checklistHeading')}
        </h3>
        <p class="leading-normal">
          {t('docs.deskQuickStart.checklistIntro')}
        </p>
        <ul class="grid gap-3">
          <li>
            <a
              class="text-foreground underline underline-offset-4"
              href={boardEntry.href}>{t(boardEntry.labelKey)}</a
            > — {t('docs.deskQuickStart.checklist.board')}
          </li>
          <li>
            <a
              class="text-foreground underline underline-offset-4"
              href={snapEntry.href}>{t(snapEntry.labelKey)}</a
            > — {t('docs.deskQuickStart.checklist.snap')}
          </li>
          <li>
            <a
              class="text-foreground underline underline-offset-4"
              href={locatingPostEntry.href}>{t(locatingPostEntry.labelKey)}</a
            > — {t('docs.deskQuickStart.checklist.locating')}
          </li>
          <li>
            <a
              class="text-foreground underline underline-offset-4"
              href={gridBoxEntry.href}>{t(gridBoxEntry.labelKey)}</a
            > — {t('docs.deskQuickStart.checklist.gridBox')}
          </li>
          <li>
            <a
              class="text-foreground underline underline-offset-4"
              href={organizerBoxEntry.href}>{t(organizerBoxEntry.labelKey)}</a
            > — {t('docs.deskQuickStart.checklist.organizerBox')}
          </li>
          <li>
            <a
              class="text-foreground underline underline-offset-4"
              href={roundBoxEntry.href}>{t(roundBoxEntry.labelKey)}</a
            > — {t('docs.deskQuickStart.checklist.roundBox')}
          </li>
        </ul>
      </section>

      <section class="grid gap-4" aria-labelledby="desk-example-title">
        <h3 class="text-2xl font-semibold" id="desk-example-title">
          {t('docs.deskQuickStart.exampleHeading')}
        </h3>
        <p class="leading-normal">
          {t('docs.deskQuickStart.exampleGridBox')}
        </p>
        <p class="leading-normal">
          {t('docs.deskQuickStart.exampleRoundBox')}
        </p>
      </section>

      <section class="grid gap-4" aria-labelledby="desk-preview-title">
        <h3 class="text-2xl font-semibold" id="desk-preview-title">
          {t('docs.deskQuickStart.previewHeading')}
        </h3>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            quickStartEntries.map((entry) => (
              <Card
                as="a"
                size="sm"
                class="cyber-card grid gap-2 p-3 no-underline transition-shadow hover:shadow-md"
                href={entry.href}
              >
                <ModelPreviewPicture
                  class="aspect-[16/10] w-full rounded-lg border border-border object-cover"
                  src={entry.previewImage.src}
                  darkSrc={entry.previewImage.darkSrc}
                  width="640"
                  height="400"
                  loading="lazy"
                  alt={t(entry.previewAltKey)}
                />
                <span class="font-semibold">{t(entry.labelKey)}</span>
                <span class="text-sm text-muted-foreground">
                  {t(entry.descriptionKey)}
                </span>
              </Card>
            ))
          }
        </div>
      </section>

      <Card as="p" size="sm" class="bg-muted p-4 text-sm text-muted-foreground">
        {t('docs.deskQuickStart.scopeNote')}
      </Card>
    </section>

    <section
      class="grid gap-6"
      aria-labelledby="docs-wall-system-title"
      data-testid="docs-wall-system"
    >
      <header class="grid gap-3">
        <h2
          class="text-3xl font-semibold leading-tight"
          id="docs-wall-system-title"
        >
          {t('docs.wall.title')}
        </h2>
        <p class="max-w-3xl leading-normal">{t('docs.wall.intro')}</p>
      </header>
      <div class="grid gap-4 sm:grid-cols-2">
        <Card as="article" size="sm" class="cyber-card grid gap-3 p-4">
          <ModelPreviewPicture
            class="aspect-[16/10] w-full rounded-lg border border-border bg-muted object-cover"
            src="/model-previews/opengrid-wall.webp"
            darkSrc="/model-previews/opengrid-wall-dark.webp"
            width="640"
            height="400"
            loading="lazy"
            alt={t('docs.wall.board.alt')}
          />
          <h3 class="m-0 text-xl font-semibold">
            {t('docs.wall.board.title')}
          </h3>
          <p class="m-0 leading-normal text-muted-foreground">
            {t('docs.wall.board.body')}
          </p>
          <a
            class="text-foreground underline underline-offset-4"
            href={wallBoardPath}>{t('docs.wall.board.cta')}</a
          >
        </Card>
        <Card as="article" size="sm" class="cyber-card grid gap-3 p-4">
          <ModelPreviewPicture
            class="aspect-[16/10] w-full rounded-lg border border-border bg-muted object-cover"
            src="/model-previews/opengrid-snap-wall.webp"
            darkSrc="/model-previews/opengrid-snap-wall-dark.webp"
            width="640"
            height="400"
            loading="lazy"
            alt={t('docs.wall.snap.alt')}
          />
          <h3 class="m-0 text-xl font-semibold">{t('docs.wall.snap.title')}</h3>
          <p class="m-0 leading-normal text-muted-foreground">
            {t('docs.wall.snap.body')}
          </p>
          <a
            class="text-foreground underline underline-offset-4"
            href={wallSnapPath}>{t('docs.wall.snap.cta')}</a
          >
        </Card>
        <Card as="article" size="sm" class="cyber-card grid gap-3 p-4">
          <ModelPreviewPicture
            class="aspect-[16/10] w-full rounded-lg border border-border bg-muted object-cover"
            src="/model-previews/opengrid-wall-cover-wall.webp"
            darkSrc="/model-previews/opengrid-wall-cover-wall-dark.webp"
            width="640"
            height="400"
            loading="lazy"
            alt={t('docs.wall.cover.alt')}
          />
          <h3 class="m-0 text-xl font-semibold">
            {t('docs.wall.cover.title')}
          </h3>
          <p class="m-0 leading-normal text-muted-foreground">
            {t('docs.wall.cover.body')}
          </p>
          <a
            class="text-foreground underline underline-offset-4"
            href={wallCoverPath}>{t('docs.wall.cover.cta')}</a
          >
        </Card>
        <Card as="article" size="sm" class="cyber-card grid gap-3 p-4">
          <ModelPreviewPicture
            class="aspect-[16/10] w-full rounded-lg border border-border bg-muted object-cover"
            src="/model-previews/opengrid-openconnect-shelf-wall.webp"
            darkSrc="/model-previews/opengrid-openconnect-shelf-wall-dark.webp"
            width="640"
            height="400"
            loading="lazy"
            alt={t('docs.wall.shelf.alt')}
          />
          <h3 class="m-0 text-xl font-semibold">
            {t('docs.wall.shelf.title')}
          </h3>
          <p class="m-0 leading-normal text-muted-foreground">
            {t('docs.wall.shelf.body')}
          </p>
          <a
            class="text-foreground underline underline-offset-4"
            href={openConnectShelfPath}>{t('docs.wall.shelf.cta')}</a
          >
        </Card>
        <Card as="article" size="sm" class="cyber-card grid gap-3 p-4">
          <ModelPreviewPicture
            class="aspect-[16/10] w-full rounded-lg border border-border bg-muted object-cover"
            src="/model-previews/opengrid-openconnect-organizer-wall.webp"
            darkSrc="/model-previews/opengrid-openconnect-organizer-wall-dark.webp"
            width="640"
            height="400"
            loading="lazy"
            alt={t('docs.wall.organizer.alt')}
          />
          <h3 class="m-0 text-xl font-semibold">
            {t('docs.wall.organizer.title')}
          </h3>
          <p class="m-0 leading-normal text-muted-foreground">
            {t('docs.wall.organizer.body')}
          </p>
          <a
            class="text-foreground underline underline-offset-4"
            href={openConnectOrganizerPath}>{t('docs.wall.organizer.cta')}</a
          >
        </Card>
        <Card as="article" size="sm" class="cyber-card grid gap-3 p-4">
          <ModelPreviewPicture
            class="aspect-[16/10] w-full rounded-lg border border-border bg-muted object-cover"
            src="/model-previews/opengrid-openconnect-tissue-box-wall.webp"
            darkSrc="/model-previews/opengrid-openconnect-tissue-box-wall-dark.webp"
            width="640"
            height="400"
            loading="lazy"
            alt={t('models.model.opengrid-openconnect-tissue-box.alt')}
          />
          <h3 class="m-0 text-xl font-semibold">
            {t('models.model.opengrid-openconnect-tissue-box.name')}
          </h3>
          <p class="m-0 leading-normal text-muted-foreground">
            {t('panel.tissueBox.help')}
          </p>
          <a
            class="text-foreground underline underline-offset-4"
            href={`/${locale}/cad/opengrid-openconnect-tissue-box?system=wall`}
            >{t('models.model.opengrid-openconnect-tissue-box.selection')}</a
          >
        </Card>
      </div>
    </section>

    <section
      class="grid gap-5"
      aria-labelledby="docs-model-reference-title"
      data-testid="docs-model-reference"
    >
      <header class="grid gap-3">
        <h2
          class="text-3xl font-semibold leading-tight"
          id="docs-model-reference-title"
        >
          {t('docs.modelReference.title')}
        </h2>
        <p class="max-w-3xl leading-normal">{t('docs.modelReference.body')}</p>
      </header>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <Card as="article" size="sm" class="cyber-card grid gap-2 p-4">
          <h3 class="m-0 text-xl font-semibold">
            {t('docs.modelReference.desk.title')}
          </h3>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('docs.modelReference.desk.body')}
          </p>
        </Card>
        <Card as="article" size="sm" class="cyber-card grid gap-2 p-4">
          <h3 class="m-0 text-xl font-semibold">
            {t('docs.modelReference.wall.title')}
          </h3>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('docs.modelReference.wall.body')}
          </p>
        </Card>
        <Card as="article" size="sm" class="cyber-card grid gap-2 p-4">
          <h3 class="m-0 text-xl font-semibold">
            {t('docs.modelReference.hsw.title')}
          </h3>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('docs.modelReference.hsw.body')}
          </p>
        </Card>
        <Card as="article" size="sm" class="cyber-card grid gap-2 p-4">
          <h3 class="m-0 text-xl font-semibold">
            {t('docs.modelReference.other.title')}
          </h3>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('docs.modelReference.other.body')}
          </p>
        </Card>
      </div>
      <Button
        as="a"
        href={publicPathFor(locale, 'models')}
        variant="outline"
        size="sm"
        class="justify-self-start no-underline"
        >{t('docs.modelReference.cta')}</Button
      >
    </section>

    <section
      class="grid gap-3"
      aria-labelledby="docs-reference-title"
      data-testid="docs-advanced-reference"
    >
      <h2
        class="text-2xl font-semibold leading-tight"
        id="docs-reference-title"
      >
        {t('docs.referenceHeading')}
      </h2>
      <p class="leading-normal">{t('docs.referenceBody')}</p>
      <p class="m-0">
        <Button
          as="a"
          href={publicPathFor(locale, 'models')}
          variant="ghost"
          size="sm"
          class="px-0 text-foreground underline underline-offset-4"
          >{t('common.backToModelsArrow')}</Button
        >
      </p>
    </section>
    <section class="grid gap-3" aria-labelledby="docs-parameters-title">
      <h2
        class="text-2xl font-semibold leading-tight"
        id="docs-parameters-title"
      >
        {t('docs.parametersHeading')}
      </h2>
      <p class="leading-normal">{t('docs.parametersBody')}</p>
    </section>
    <section class="grid gap-3" aria-labelledby="docs-units-title">
      <h2 class="text-2xl font-semibold leading-tight" id="docs-units-title">
        {t('docs.unitsHeading')}
      </h2>
      <p class="leading-normal">{t('docs.unitsBody')}</p>
    </section>
    <section class="grid gap-3" aria-labelledby="docs-exports-title">
      <h2 class="text-2xl font-semibold leading-tight" id="docs-exports-title">
        {t('docs.exportsHeading')}
      </h2>
      <p class="leading-normal">{t('docs.exportsBody')}</p>
    </section>
    <section class="grid gap-3" aria-labelledby="docs-browser-title">
      <h2 class="text-2xl font-semibold leading-tight" id="docs-browser-title">
        {t('docs.browserHeading')}
      </h2>
      <p class="leading-normal">{t('docs.browserBody')}</p>
    </section>
    <p class="leading-normal">{t('docs.architecture')}</p>
  </Card>
</SiteLayout>
