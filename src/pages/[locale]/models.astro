---
import SiteLayout from '../../layouts/SiteLayout.astro'
import '../../styles/starwind.css'
import { Badge } from '../../components/starwind/badge'
import ModelCard from '../../components/cad/ModelCard.astro'
import {
  groupModelDefinitions,
  partitionByPartZone,
} from '../../features/cad/model-catalog'
import { SUPPORTED_LOCALES, isLocale, translate, type Locale } from '../../i18n'
import { localizedPathFor } from '../../i18n/routes'

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}

const locale = Astro.props.locale as Locale
if (!isLocale(locale)) throw new Error(`UNSUPPORTED_LOCALE:${locale}`)
const t = (key: string, values?: Record<string, string | number | boolean>) =>
  translate(locale, key, values)
const modelGroups = groupModelDefinitions()

const opengridGroup = modelGroups.find((group) => group.key === 'opengrid')
const otherGroup = modelGroups.find((group) => group.key === 'other')

const systemSubgroups = opengridGroup?.subgroups ?? []
const deskSubgroup = systemSubgroups.find((subgroup) => subgroup.key === 'desk')
const wallSubgroup = systemSubgroups.find((subgroup) => subgroup.key === 'wall')
const otherDefinitions = otherGroup?.definitions ?? []

const deskZones = deskSubgroup
  ? partitionByPartZone(deskSubgroup.definitions)
  : null
const wallZones = wallSubgroup
  ? partitionByPartZone(wallSubgroup.definitions)
  : null
const otherZones = partitionByPartZone(otherDefinitions)

const systemTabs = [
  { key: 'desk', label: 'Desk' },
  { key: 'wall', label: 'Wall' },
  { key: 'other', label: t('models.switcher.other') },
] as const
---

<SiteLayout
  {locale}
  fullWidth
  title={`${t('models.title')} | Shape Shortcut`}
  description={t('models.description')}
>
  <section
    class="grid gap-8"
    aria-labelledby="model-selection-title"
    data-testid="model-selection"
  >
    <header class="grid justify-items-center gap-3 text-center">
      <Badge variant="outline" eyebrow size="sm">
        {t('models.series')}
      </Badge>
      <h1
        class="text-4xl font-semibold leading-tight"
        id="model-selection-title"
      >
        {t('models.title')}
      </h1>
      <p class="m-0 max-w-2xl leading-relaxed text-muted-foreground">
        {t('models.lede')}
      </p>
      <a
        class="inline-flex min-h-11 w-fit items-center rounded-full border border-border bg-background px-5 py-2 font-semibold text-foreground no-underline hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline"
        data-testid="playground-entry"
        href={localizedPathFor(locale, '/cad/playground')}
      >
        {t('playground.entry')}
      </a>
    </header>

    <h2 class="sr-only" id="opengrid-series-title">
      {t('models.family.opengrid')}
    </h2>

    {
      /* v2 palette: segmented system switcher above a single panel
        (progressive enhancement — without JS all panels stack). */
    }
    <div
      class="flex flex-wrap items-center gap-1 rounded-full border border-border bg-card p-1 shadow-soft"
      role="group"
      aria-label={t('models.switcher.label')}
      data-testid="model-system-switcher"
    >
      {
        systemTabs.map((tab) => (
          <button
            type="button"
            data-system-tab={tab.key}
            aria-pressed={tab.key === 'desk' ? 'true' : 'false'}
            class="min-h-9 rounded-full px-4 py-1.5 text-sm font-extrabold text-muted-foreground transition-colors duration-200 ease-out hover:bg-muted hover:text-foreground focus-visible:ring-3 focus-visible:ring-outline aria-pressed:bg-primary aria-pressed:text-primary-foreground aria-pressed:shadow-soft aria-pressed:hover:bg-primary"
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <div class="grid gap-10">
      {
        [
          {
            key: 'desk',
            title: t('models.context.desk'),
            zones: deskZones,
            labelledBy: 'model-subgroup-desk-title',
          },
          {
            key: 'wall',
            title: t('models.context.wall'),
            zones: wallZones,
            labelledBy: 'model-subgroup-wall-title',
          },
          {
            key: 'other',
            title: t('models.switcher.other'),
            zones: otherZones,
            labelledBy: 'model-subgroup-other-title',
          },
        ].map((panel) =>
          panel.zones ? (
            <section
              class="overflow-hidden rounded-[20px] border border-border bg-muted shadow-soft"
              aria-labelledby={panel.labelledBy}
              data-testid={`model-subgroup-${panel.key}`}
              data-system-panel={panel.key}
            >
              <div class="flex items-baseline gap-2 border-b border-border px-4 py-4">
                <h3
                  class="m-0 text-[15px] font-black leading-snug"
                  id={panel.labelledBy}
                >
                  {t('models.panel.title')}
                  <span class="sr-only">（{panel.title}）</span>
                </h3>
                {panel.zones.tools.length > 0 && (
                  <span class="text-[12.5px] font-bold text-muted-foreground">
                    {t('models.panel.hint')}
                  </span>
                )}
              </div>
              <div class="grid gap-4 px-4 pt-4 pb-4">
                {panel.zones.base.length > 0 && (
                  <div
                    role="group"
                    aria-label={t('models.zone.base')}
                    data-testid={`model-zone-base-${panel.key}`}
                    class="grid gap-2"
                  >
                    {panel.zones.base.map((definition) => (
                      <ModelCard {definition} {locale} />
                    ))}
                  </div>
                )}
                {panel.zones.containers.length > 0 && (
                  <div class="grid gap-2">
                    <div class="flex items-baseline gap-2">
                      <span class="text-[13px] font-black tracking-wide">
                        {t('models.zone.containers')}
                      </span>
                      <span class="text-xs font-bold text-muted-foreground">
                        {t('models.zone.containersHint')}
                      </span>
                    </div>
                    <div
                      role="group"
                      aria-label={t('models.zone.containers')}
                      data-testid={`model-zone-containers-${panel.key}`}
                      class="grid grid-cols-1 gap-2.5 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4"
                    >
                      {panel.zones.containers.map((definition) => (
                        <ModelCard {definition} {locale} />
                      ))}
                    </div>
                  </div>
                )}
                {panel.zones.tools.length > 0 && (
                  <details
                    class="group"
                    data-testid={`model-zone-tools-${panel.key}`}
                  >
                    <summary class="flex cursor-pointer list-none flex-wrap items-baseline gap-2 [&::-webkit-details-marker]:hidden">
                      <span class="text-[15px] font-black">
                        {t('models.zone.tools')}
                      </span>
                      <span class="text-[12.5px] font-bold text-muted-foreground">
                        {t('models.zone.toolsHint')}
                      </span>
                      <span
                        class="ms-auto flex items-center gap-1 text-[13px] font-extrabold text-primary"
                        aria-hidden="true"
                      >
                        <span class="group-open:hidden">
                          ▸ {t('models.zone.expand')}
                        </span>
                        <span class="hidden group-open:inline">
                          ▾ {t('models.zone.collapse')}
                        </span>
                      </span>
                      <span class="mt-2 block w-full rounded-[12px] bg-[#f6f1ed] px-3.5 py-2.5 text-[13px] font-bold leading-normal text-muted-foreground dark:bg-[#332a24]">
                        {t('models.zone.toolsTeaser')}
                      </span>
                    </summary>
                    <div
                      class="grid gap-2 px-0 py-3"
                      data-testid={`model-tools-grid-${panel.key}`}
                    >
                      {panel.zones.tools.map((definition) => (
                        <ModelCard {definition} {locale} />
                      ))}
                    </div>
                  </details>
                )}
              </div>
            </section>
          ) : null,
        )
      }
    </div>
  </section>
  <script is:inline>
    const canUseModal =
      typeof HTMLDialogElement !== 'undefined' &&
      typeof HTMLDialogElement.prototype.showModal === 'function'
    for (const opener of document.querySelectorAll(
      '[data-model-details-open]',
    )) {
      const dialogId = opener.getAttribute('data-model-details-open')
      const dialog = dialogId ? document.getElementById(dialogId) : null
      if (!canUseModal || !(dialog instanceof HTMLDialogElement)) continue

      opener.removeAttribute('hidden')
      const fallback = opener.parentElement?.querySelector(
        '[data-model-details-fallback]',
      )
      fallback?.setAttribute('hidden', '')
      let lastOpener = null
      opener.addEventListener('click', () => {
        lastOpener = opener
        if (!dialog.open) dialog.showModal()
      })
      dialog.addEventListener('close', () => {
        if (lastOpener instanceof HTMLElement) lastOpener.focus()
        lastOpener = null
      })
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close()
      })
    }

    // System switcher: show exactly one panel once scripting is available;
    // the server-rendered page stacks all panels as the no-JS fallback.
    const switcher = document.querySelector(
      '[data-testid=model-system-switcher]',
    )
    if (switcher) {
      const tabs = Array.from(switcher.querySelectorAll('[data-system-tab]'))
      const panels = Array.from(
        document.querySelectorAll('[data-system-panel]'),
      )
      const apply = function (key) {
        for (const tab of tabs) {
          tab.setAttribute(
            'aria-pressed',
            String(tab.getAttribute('data-system-tab') === key),
          )
        }
        for (const panel of panels) {
          if (panel.getAttribute('data-system-panel') === key) {
            panel.removeAttribute('hidden')
          } else {
            panel.setAttribute('hidden', '')
          }
        }
      }
      apply('desk')
      for (const tab of tabs) {
        tab.addEventListener('click', function () {
          apply(tab.getAttribute('data-system-tab'))
        })
      }
    }
  </script>
</SiteLayout>
