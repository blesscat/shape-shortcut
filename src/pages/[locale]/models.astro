---
import SiteLayout from '../../layouts/SiteLayout.astro'
import '../../styles/starwind.css'
import { Badge } from '../../components/starwind/badge'
import { Button } from '../../components/starwind/button'
import { Card } from '../../components/starwind/card'
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from '../../components/starwind/dialog'
import { Separator } from '../../components/starwind/separator'
import ModelPreviewPicture from '../../components/ModelPreviewPicture.astro'
import {
  displayParameterLabel,
  groupModelDefinitions,
  modelSelectionLabelFor,
  parameterPresentationFor,
  parameterStaticSummaryKeysFor,
  unitLabelFor,
  type ModelDefinition,
} from '../../features/cad/model-catalog'
import { SUPPORTED_LOCALES, isLocale, translate, type Locale } from '../../i18n'
import { localizedCadPathFor, localizedPathFor } from '../../i18n/routes'

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}

const locale = Astro.props.locale as Locale
if (!isLocale(locale)) throw new Error(`UNSUPPORTED_LOCALE:${locale}`)
const t = (key: string, values?: Record<string, string | number | boolean>) =>
  translate(locale, key, values)
const modelGroups = groupModelDefinitions()

function previewImageFor(definition: ModelDefinition) {
  if (!definition.previewImage) {
    throw new Error(`MODEL_PREVIEW_MISSING:${definition.id}`)
  }
  return definition.previewImage
}

function modelText(
  definition: ModelDefinition,
  field: 'name' | 'description' | 'alt',
) {
  return t(`models.model.${definition.id}.${field}`)
}

function groupText(groupKey: string): string {
  return t(`models.family.${groupKey}`)
}

function subgroupText(
  groupKey: string,
  subgroupKey: string,
  hasSubgroups: boolean,
): string {
  if (hasSubgroups) return t(`models.context.${subgroupKey}`)
  return groupText(groupKey)
}

function translatedSummaryFor(key: string | undefined): string | undefined {
  if (!key) return undefined
  const summary = t(key)
  if (summary.startsWith('⟦')) return undefined
  return summary
}

function translatedStaticSummariesFor(definition: ModelDefinition): string[] {
  return parameterStaticSummaryKeysFor(definition)
    .map((key) => translatedSummaryFor(key))
    .filter((summary): summary is string => summary !== undefined)
}

function parameterSummary(definition: ModelDefinition): string[] {
  const presentation = parameterPresentationFor(definition)
  const staticSummaries = translatedStaticSummariesFor(definition)
  if (staticSummaries.length > 0) return staticSummaries

  if (presentation.kind === 'fixed') {
    return [t('models.fixedParameters')]
  }

  if (definition.parameterSchema.length === 0) {
    return [t('models.adjustableSettingsMultiple')]
  }

  return definition.parameterSchema.map((field) =>
    t('models.parameterRange', {
      label: displayParameterLabel(field, locale),
      min: field.min,
      max: field.max,
      unit: unitLabelFor(locale, field.unit),
    }),
  )
}

function detailsDialogIdFor(definition: ModelDefinition): string {
  return `model-details-${definition.id}-${definition.systemContext ?? 'legacy'}`
}
---

<SiteLayout
  {locale}
  fullWidth
  title={`${t('models.title')} | Shape Shortcut`}
  description={t('models.description')}
>
  <section
    class="grid gap-10"
    aria-labelledby="model-selection-title"
    data-testid="model-selection"
  >
    <header class="grid justify-items-center gap-3 text-center">
      <Badge variant="outline" eyebrow size="sm">
        {t('models.series')}
      </Badge>
      <h1
        class="text-4xl font-semibold leading-tight"
        id="model-selection-title"
      >
        {t('models.title')}
      </h1>
      <a
        class="inline-flex w-fit items-center rounded-lg border border-border bg-background px-4 py-2 font-semibold text-foreground no-underline shadow-sm hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline/50"
        data-testid="playground-entry"
        href={localizedPathFor(locale, '/cad/playground')}
      >
        {t('playground.entry')}
      </a>
    </header>

    <div class="grid gap-12" aria-label={t('models.series')}>
      {
        modelGroups.map((group) => {
          const hasSubgroups = Boolean(group.subgroups)
          const subgroups = group.subgroups ?? [
            {
              key: group.key,
              label: group.label,
              definitions: group.definitions,
            },
          ]

          return (
            <section
              class="grid gap-6"
              aria-labelledby={`model-family-${group.key}`}
              data-testid={`model-family-${group.key}`}
            >
              <div class="grid justify-items-center gap-3 text-center">
                <h2
                  class="text-3xl font-semibold leading-tight"
                  id={`model-family-${group.key}`}
                >
                  {groupText(group.key)}
                </h2>
                <Separator class="bg-border" />
              </div>
              <div
                class="grid gap-10"
                data-testid={
                  hasSubgroups ? `model-subgroups-${group.key}` : undefined
                }
              >
                {subgroups.map((subgroup) => (
                  <section
                    class="grid gap-4"
                    aria-labelledby={
                      hasSubgroups
                        ? `model-subgroup-${subgroup.key}-title`
                        : undefined
                    }
                    data-testid={`model-subgroup-${subgroup.key}`}
                  >
                    {hasSubgroups ? (
                      <div class="grid justify-items-center gap-2 text-center">
                        <h3
                          class="text-xl font-semibold leading-tight"
                          id={`model-subgroup-${subgroup.key}-title`}
                        >
                          {subgroupText(group.key, subgroup.key, hasSubgroups)}
                        </h3>
                        <Separator class="bg-border" />
                      </div>
                    ) : null}
                    <div class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(min(100%,18rem),1fr))]">
                      {subgroup.definitions.map((definition) => {
                        const preview = previewImageFor(definition)
                        const selectionLabel = t(
                          modelSelectionLabelFor(definition),
                        )
                        const description = modelText(definition, 'description')
                        const previewAlt = modelText(definition, 'alt')
                        const parameterDetails = parameterSummary(definition)
                        const dialogId = detailsDialogIdFor(definition)
                        const cadPath = localizedCadPathFor(
                          locale,
                          definition.id,
                          definition.systemContext,
                        )
                        return (
                          <Card
                            as="article"
                            size="sm"
                            class="cyber-card grid gap-3 p-3 shadow-sm transition-shadow hover:shadow-md sm:p-4"
                            data-model-id={definition.id}
                            data-entry-key={`${definition.id}-${definition.systemContext ?? 'legacy'}`}
                            data-system-context={definition.systemContext}
                          >
                            <div
                              class="grid aspect-[16/10] place-items-center overflow-hidden rounded-lg border border-border bg-muted"
                              data-testid="model-preview"
                            >
                              <div
                                class="p-4 text-center text-sm text-muted-foreground"
                                data-testid="model-preview-fallback"
                                hidden
                                role="img"
                                aria-label={previewAlt}
                              >
                                {t('models.previewUnavailable')}
                              </div>
                              <ModelPreviewPicture
                                src={preview.src}
                                darkSrc={preview.darkSrc}
                                width={preview.width}
                                height={preview.height}
                                alt={previewAlt}
                                loading="lazy"
                                class="h-full w-full object-contain"
                                onerror="if (this.offsetParent) { this.hidden = true; this.closest('[data-testid=model-preview]')?.querySelector('[data-testid=model-preview-fallback]')?.removeAttribute('hidden') }"
                              />
                            </div>
                            {hasSubgroups ? (
                              <h4 class="text-2xl font-semibold leading-tight">
                                {selectionLabel}
                              </h4>
                            ) : (
                              <h3 class="text-2xl font-semibold leading-tight">
                                {selectionLabel}
                              </h3>
                            )}
                            <p class="m-0 text-sm leading-normal text-muted-foreground">
                              {description}
                            </p>
                            <div class="grid gap-2 text-sm leading-normal">
                              <Dialog>
                                <DialogTrigger
                                  class="inline-flex w-fit items-center rounded-lg border border-border bg-background px-3 py-2 font-semibold text-foreground shadow-sm hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline/50"
                                  data-model-details-open={dialogId}
                                  aria-controls={dialogId}
                                  hidden
                                >
                                  {t('models.details')}
                                </DialogTrigger>
                                <a
                                  class="inline-flex w-fit items-center rounded-lg border border-border bg-background px-3 py-2 font-semibold text-foreground no-underline shadow-sm hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline/50"
                                  data-model-details-fallback
                                  href={cadPath}
                                >
                                  {t('models.details')}
                                </a>
                                <DialogContent
                                  id={dialogId}
                                  class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100vw-2rem)] max-w-2xl overflow-hidden rounded-2xl border-border bg-card p-0 text-foreground shadow-lg"
                                  aria-labelledby={`${dialogId}-title`}
                                  data-testid="model-details-dialog"
                                  closeLabel={t('models.close')}
                                >
                                  <div
                                    class="grid max-h-[calc(100dvh-2rem)] min-w-0 gap-5 overflow-y-auto p-5 sm:p-6"
                                    data-testid="model-details-scroll"
                                  >
                                    <DialogHeader class="min-w-0 items-start gap-0 text-left">
                                      <DialogTitle
                                        class="m-0 break-words text-2xl font-semibold leading-tight"
                                        id={`${dialogId}-title`}
                                      >
                                        {selectionLabel}
                                      </DialogTitle>
                                      <DialogDescription class="sr-only">
                                        {description}
                                      </DialogDescription>
                                    </DialogHeader>
                                    <Separator class="bg-border" />
                                    <section class="grid min-w-0 gap-2 text-sm leading-normal">
                                      <h3 class="m-0 text-lg font-semibold leading-tight">
                                        {t('models.parameters')}
                                      </h3>
                                      <ul class="m-0 grid gap-1 break-words pl-5">
                                        {parameterDetails.map((summary) => (
                                          <li>{summary}</li>
                                        ))}
                                      </ul>
                                      <p class="m-0 break-words text-muted-foreground">
                                        {t('models.exportFormatsLine', {
                                          label: t('models.exportFormats'),
                                          value: t('models.exportFormatsValue'),
                                        })}
                                      </p>
                                    </section>
                                  </div>
                                </DialogContent>
                              </Dialog>
                            </div>
                            <Button
                              as="a"
                              href={cadPath}
                              variant="outline"
                              size="sm"
                              class="justify-self-start no-underline"
                              aria-label={t('models.editAria', {
                                name: selectionLabel,
                              })}
                            >
                              {t('models.edit')}
                            </Button>
                          </Card>
                        )
                      })}
                    </div>
                  </section>
                ))}
              </div>
            </section>
          )
        })
      }
    </div>
  </section>
  <script is:inline>
    const canUseModal =
      typeof HTMLDialogElement !== 'undefined' &&
      typeof HTMLDialogElement.prototype.showModal === 'function'
    for (const opener of document.querySelectorAll(
      '[data-model-details-open]',
    )) {
      const dialogId = opener.getAttribute('data-model-details-open')
      const dialog = dialogId ? document.getElementById(dialogId) : null
      if (!canUseModal || !(dialog instanceof HTMLDialogElement)) continue

      opener.removeAttribute('hidden')
      const fallback = opener.parentElement?.querySelector(
        '[data-model-details-fallback]',
      )
      fallback?.setAttribute('hidden', '')
      let lastOpener = null
      opener.addEventListener('click', () => {
        lastOpener = opener
        if (!dialog.open) dialog.showModal()
      })
      dialog.addEventListener('close', () => {
        if (lastOpener instanceof HTMLElement) lastOpener.focus()
        lastOpener = null
      })
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close()
      })
    }
  </script>
</SiteLayout>
