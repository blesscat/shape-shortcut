---
import SiteLayout from '../../layouts/SiteLayout.astro'
import '../../styles/starwind.css'
import { Badge } from '../../components/starwind/badge'
import { Separator } from '../../components/starwind/separator'
import ModelCard from '../../components/cad/ModelCard.astro'
import {
  groupModelDefinitions,
  partitionByPartZone,
} from '../../features/cad/model-catalog'
import { SUPPORTED_LOCALES, isLocale, translate, type Locale } from '../../i18n'
import { localizedPathFor } from '../../i18n/routes'

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}

const locale = Astro.props.locale as Locale
if (!isLocale(locale)) throw new Error(`UNSUPPORTED_LOCALE:${locale}`)
const t = (key: string, values?: Record<string, string | number | boolean>) =>
  translate(locale, key, values)
const modelGroups = groupModelDefinitions()

function groupText(groupKey: string): string {
  return t(`models.family.${groupKey}`)
}

function subgroupText(
  groupKey: string,
  subgroupKey: string,
  hasSubgroups: boolean,
): string {
  if (hasSubgroups) return t(`models.context.${subgroupKey}`)
  return groupText(groupKey)
}
---

<SiteLayout
  {locale}
  fullWidth
  title={`${t('models.title')} | Shape Shortcut`}
  description={t('models.description')}
>
  <section
    class="grid gap-10"
    aria-labelledby="model-selection-title"
    data-testid="model-selection"
  >
    <header class="grid justify-items-center gap-3 text-center">
      <Badge variant="outline" eyebrow size="sm">
        {t('models.series')}
      </Badge>
      <h1
        class="text-4xl font-semibold leading-tight"
        id="model-selection-title"
      >
        {t('models.title')}
      </h1>
      <p class="m-0 max-w-2xl leading-relaxed text-muted-foreground">
        {t('models.lede')}
      </p>
      <a
        class="inline-flex min-h-11 w-fit items-center rounded-full border border-border bg-background px-5 py-2 font-semibold text-foreground no-underline hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline"
        data-testid="playground-entry"
        href={localizedPathFor(locale, '/cad/playground')}
      >
        {t('playground.entry')}
      </a>
    </header>

    <div class="grid gap-12" aria-label={t('models.series')}>
      {
        modelGroups.map((group) => {
          const hasSubgroups = Boolean(group.subgroups)
          const subgroups = group.subgroups ?? [
            {
              key: group.key,
              label: group.label,
              definitions: group.definitions,
            },
          ]

          return (
            <section
              class="grid gap-6"
              aria-labelledby={`model-family-${group.key}`}
              data-testid={`model-family-${group.key}`}
            >
              <div class="grid justify-items-center gap-3 text-center">
                <h2
                  class="text-3xl font-semibold leading-tight"
                  id={`model-family-${group.key}`}
                >
                  {groupText(group.key)}
                </h2>
                <Separator class="bg-border" />
              </div>
              <div
                class="grid gap-10"
                data-testid={
                  hasSubgroups ? `model-subgroups-${group.key}` : undefined
                }
              >
                {subgroups.map((subgroup) => {
                  const zones = hasSubgroups
                    ? partitionByPartZone(subgroup.definitions)
                    : null

                  return (
                    <section
                      class="grid gap-4"
                      aria-labelledby={
                        hasSubgroups
                          ? `model-subgroup-${subgroup.key}-title`
                          : undefined
                      }
                      data-testid={`model-subgroup-${subgroup.key}`}
                    >
                      {hasSubgroups ? (
                        <div class="grid justify-items-center gap-2 text-center">
                          <h3
                            class="text-xl font-semibold leading-tight"
                            id={`model-subgroup-${subgroup.key}-title`}
                          >
                            {subgroupText(
                              group.key,
                              subgroup.key,
                              hasSubgroups,
                            )}
                          </h3>
                          <Separator class="bg-border" />
                        </div>
                      ) : null}
                      {zones ? (
                        <div class="grid gap-6">
                          <div
                            role="group"
                            aria-label={t('models.zone.base')}
                            data-testid="model-zone-base"
                            class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(min(100%,16rem),1fr))]"
                          >
                            {zones.base.map((definition) => (
                              <ModelCard {definition} {locale} />
                            ))}
                          </div>
                          <div
                            role="group"
                            aria-label={t('models.zone.containers')}
                            data-testid="model-zone-containers"
                            class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(min(100%,20rem),1fr))]"
                          >
                            {zones.containers.map((definition) => (
                              <ModelCard {definition} {locale} />
                            ))}
                          </div>
                          <details
                            class="group overflow-hidden rounded-2xl border border-border bg-card"
                            data-testid="model-zone-tools"
                          >
                            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 px-4 py-3 font-semibold text-foreground [&::-webkit-details-marker]:hidden">
                              <span>{t('models.zone.tools')}</span>
                              <span
                                class="text-muted-foreground group-open:rotate-180"
                                aria-hidden="true"
                              >
                                ▾
                              </span>
                            </summary>
                            <div
                              class="grid gap-4 border-t border-border py-4 [grid-template-columns:repeat(auto-fill,minmax(min(100%,16rem),1fr))]"
                              data-testid="model-tools-grid"
                            >
                              {zones.tools.map((definition) => (
                                <ModelCard {definition} {locale} />
                              ))}
                            </div>
                          </details>
                        </div>
                      ) : (
                        <div class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(min(100%,18rem),1fr))]">
                          {subgroup.definitions.map((definition) => (
                            <ModelCard {definition} {locale} />
                          ))}
                        </div>
                      )}
                    </section>
                  )
                })}
              </div>
            </section>
          )
        })
      }
    </div>
  </section>
  <script is:inline>
    const canUseModal =
      typeof HTMLDialogElement !== 'undefined' &&
      typeof HTMLDialogElement.prototype.showModal === 'function'
    for (const opener of document.querySelectorAll(
      '[data-model-details-open]',
    )) {
      const dialogId = opener.getAttribute('data-model-details-open')
      const dialog = dialogId ? document.getElementById(dialogId) : null
      if (!canUseModal || !(dialog instanceof HTMLDialogElement)) continue

      opener.removeAttribute('hidden')
      const fallback = opener.parentElement?.querySelector(
        '[data-model-details-fallback]',
      )
      fallback?.setAttribute('hidden', '')
      let lastOpener = null
      opener.addEventListener('click', () => {
        lastOpener = opener
        if (!dialog.open) dialog.showModal()
      })
      dialog.addEventListener('close', () => {
        if (lastOpener instanceof HTMLElement) lastOpener.focus()
        lastOpener = null
      })
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close()
      })
    }
  </script>
</SiteLayout>
