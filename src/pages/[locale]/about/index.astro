---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import '../../../styles/starwind.css'
import { Badge } from '../../../components/starwind/badge'
import { Button } from '../../../components/starwind/button'
import { Card } from '../../../components/starwind/card'
import { supportProviders } from '../../../features/support/config'
import {
  SUPPORTED_LOCALES,
  isLocale,
  translate,
  type Locale,
} from '../../../i18n'
import { publicPathFor } from '../../../i18n/routes'

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}

const locale = Astro.props.locale as Locale
if (!isLocale(locale)) throw new Error(`UNSUPPORTED_LOCALE:${locale}`)
const t = (key: string) => translate(locale, key)
const modelsPath = publicPathFor(locale, 'models')
const docsPath = publicPathFor(locale, 'docs')
---

<SiteLayout
  {locale}
  title={t('about.metaTitle')}
  description={t('about.description')}
>
  <article class="grid gap-10" data-testid="about-page">
    <Card as="header" class="p-5 sm:p-8">
      <div class="flex flex-col items-center gap-6">
        <img
          class="aspect-square w-28 shrink-0 rounded-img border border-border bg-muted object-cover sm:w-36"
          src="/about/blesscat.png"
          width="640"
          height="640"
          loading="eager"
          alt={t('about.portraitAlt')}
        />
        <div class="grid gap-4 text-center">
          <Badge
            tone="primary"
            appearance="soft"
            size="sm"
            class="w-fit self-center font-semibold text-primary-hover dark:text-primary"
          >
            {t('about.eyebrow')}
          </Badge>
          <h1 class="m-0 text-4xl font-semibold leading-tight sm:text-5xl">
            {t('about.title')}
          </h1>
          <p class="m-0 text-lg font-semibold text-foreground">
            {t('about.role')}
          </p>
          <p class="m-0 max-w-2xl leading-relaxed text-muted-foreground">
            {t('about.intro')}
          </p>
          <Badge
            variant="secondary"
            size="sm"
            class="w-fit self-center font-semibold sm:self-start"
          >
            {t('about.status')}
          </Badge>
        </div>
      </div>
    </Card>

    <Card
      as="section"
      class="grid gap-3 p-5 sm:p-8"
      aria-labelledby="about-story-title"
      data-testid="about-story"
    >
      <h2
        class="m-0 text-3xl font-semibold leading-tight"
        id="about-story-title"
      >
        {t('about.storyHeading')}
      </h2>
      <p class="m-0 max-w-3xl leading-relaxed text-muted-foreground">
        {t('about.storyBody')}
      </p>
    </Card>

    <Card
      as="section"
      class="grid gap-3 p-5 sm:p-8"
      aria-labelledby="about-project-title"
      data-testid="about-project"
    >
      <h2
        class="m-0 text-3xl font-semibold leading-tight"
        id="about-project-title"
      >
        {t('about.projectHeading')}
      </h2>
      <p class="m-0 max-w-3xl leading-relaxed text-muted-foreground">
        {t('about.projectBody')}
      </p>
    </Card>

    <Card
      as="section"
      class="grid gap-5 bg-banner p-5 text-banner-foreground ring-0 sm:p-8"
      aria-labelledby="about-links-title"
      data-testid="about-links"
    >
      <div class="grid gap-2">
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="about-links-title"
        >
          {t('about.linksHeading')}
        </h2>
        <p class="m-0 max-w-2xl leading-relaxed text-banner-foreground/85">
          {t('about.supportDescription')}
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button
          as="a"
          href="https://github.com/blesscat"
          variant="neon"
          size="lg"
          class="no-underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('about.github')}
        </Button>
        <Button
          as="a"
          href="mailto:blesscat@gmail.com"
          variant="outline"
          size="lg"
          class="!border-border-field !bg-transparent !text-foreground no-underline hover:!bg-foreground/5 focus-visible:ring-outline/50"
        >
          {t('about.email')}
        </Button>
        {
          supportProviders.length > 0 && (
            <Button
              type="button"
              variant="outline"
              size="lg"
              class="!border-border-field !bg-transparent !text-foreground no-underline hover:!bg-foreground/5 focus-visible:ring-outline/50"
              data-support-dialog-open
              data-testid="about-support-trigger"
              aria-controls="support-dialog"
              aria-haspopup="dialog"
            >
              {t('about.support')}
            </Button>
          )
        }
      </div>
    </Card>

    <nav
      class="flex flex-wrap gap-x-5 gap-y-3"
      aria-label={t('navigation.primary')}
    >
      <Button
        as="a"
        href={modelsPath}
        variant="ghost"
        size="sm"
        class="px-0 font-semibold text-foreground underline underline-offset-4"
        >{t('about.modelsCta')}</Button
      >
      <Button
        as="a"
        href={docsPath}
        variant="ghost"
        size="sm"
        class="px-0 font-semibold text-foreground underline underline-offset-4"
        >{t('about.docsCta')}</Button
      >
    </nav>
  </article>
</SiteLayout>
