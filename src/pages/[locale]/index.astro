---
import SiteLayout from '../../layouts/SiteLayout.astro'
import '../../styles/starwind.css'
import { Badge } from '../../components/starwind/badge'
import { Button } from '../../components/starwind/button'
import { Card } from '../../components/starwind/card'
import ModelPreviewPicture from '../../components/ModelPreviewPicture.astro'
import LayoutGridIcon from '@tabler/icons/outline/layout-grid.svg'
import AdjustmentsIcon from '@tabler/icons/outline/adjustments-horizontal.svg'
import ArrowRightIcon from '@tabler/icons/outline/arrow-right.svg'
import DownloadIcon from '@tabler/icons/outline/download.svg'
import BrandGithubIcon from '@tabler/icons/outline/brand-github.svg'
import MailIcon from '@tabler/icons/outline/mail.svg'
import { supportProviders } from '../../features/support/config'
import { SUPPORTED_LOCALES, isLocale, translate, type Locale } from '../../i18n'
import { localizedCadPathFor, publicPathFor } from '../../i18n/routes'

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}

const locale = Astro.props.locale as Locale
if (!isLocale(locale)) throw new Error(`UNSUPPORTED_LOCALE:${locale}`)
const t = (key: string) => translate(locale, key)
const deskBoardPath = localizedCadPathFor(locale, 'opengrid', 'desk')
const wallBoardPath = localizedCadPathFor(locale, 'opengrid', 'wall')
const modelsPath = publicPathFor(locale, 'models')
const docsPath = publicPathFor(locale, 'docs')
const aboutPath = publicPathFor(locale, 'about')

const inlineLinkClass =
  'font-semibold text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground focus-visible:ring-3 focus-visible:ring-outline/50'

const heroBadges = [
  { key: 'home.badge.noInstall', testid: 'home-badge-no-install' },
  { key: 'home.badge.inBrowser', testid: 'home-badge-in-browser' },
  { key: 'home.badge.freeForever', testid: 'home-badge-free-forever' },
] as const
const systems = [
  { id: 'desk', href: deskBoardPath, number: '01' },
  { id: 'wall', href: wallBoardPath, number: '02' },
] as const
const steps = [
  { id: 'choose', Icon: LayoutGridIcon },
  { id: 'adjust', Icon: AdjustmentsIcon },
  { id: 'download', Icon: DownloadIcon },
] as const
---

<SiteLayout
  {locale}
  title={t('home.metaTitle')}
  description={t('home.metaDescription')}
>
  <div class="grid gap-16 lg:gap-24" data-testid="home-sections">
    <section
      class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-12"
      aria-labelledby="home-title"
      data-testid="home-hero"
    >
      <div class="grid gap-5">
        <ul
          class="m-0 flex list-none flex-wrap gap-2 p-0"
          data-testid="home-hero-badges"
        >
          {
            heroBadges.map((badge) => (
              <li>
                <Badge
                  tone="primary"
                  appearance="soft"
                  size="sm"
                  class="font-semibold text-primary-hover dark:text-primary"
                  data-testid={badge.testid}
                >
                  {t(badge.key)}
                </Badge>
              </li>
            ))
          }
        </ul>
        <h1
          class="m-0 text-4xl font-semibold leading-tight sm:text-5xl"
          id="home-title"
        >
          {t('home.title')}<br /><span
            class="text-primary-strong dark:text-primary"
            >{t('home.titleAccent')}</span
          >
        </h1>
        <p class="m-0 max-w-xl text-lg leading-relaxed text-muted-foreground">
          {t('home.description')}
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button
            as="a"
            href={modelsPath}
            variant="neon"
            size="lg"
            class="no-underline">{t('home.primaryCta')}</Button
          >
          <Button
            as="a"
            href={docsPath}
            variant="outline"
            size="lg"
            class="no-underline">{t('home.secondaryCta')}</Button
          >
        </div>
        <p
          class="m-0 text-sm text-muted-foreground"
          data-testid="home-file-card"
        >
          {t('home.fileCard.downloadValue')}
        </p>
      </div>
      <figure
        class="m-0 overflow-hidden rounded-container border border-border bg-muted"
        data-testid="home-hero-visual"
      >
        <ModelPreviewPicture
          class="block aspect-[3/2] h-auto w-full object-cover"
          src="/home/desk.light.webp"
          darkSrc="/home/desk.dark.webp"
          width={1200}
          height={800}
          loading="eager"
          alt={t('home.heroVisual.alt')}
        />
        <figcaption
          class="flex flex-wrap items-center justify-between gap-2 px-5 py-4 text-sm text-muted-foreground"
        >
          <span class="font-semibold text-foreground">OpenGrid Desk</span><span
            >{t('home.heroVisual.caption')}</span
          >
        </figcaption>
      </figure>
    </section>

    <section
      class="grid gap-6"
      aria-labelledby="home-explore-title"
      data-testid="home-explore"
    >
      <header class="grid gap-2">
        <p
          class="m-0 text-sm font-semibold text-primary-strong dark:text-primary"
        >
          {t('home.explore.eyebrow')}
        </p>
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="home-explore-title"
        >
          {t('home.explore.title')}
        </h2>
      </header>
      <div class="grid gap-6 md:grid-cols-2">
        {
          systems.map((system) => (
            <Card
              as="article"
              class="grid content-start gap-0 overflow-hidden p-0"
            >
              <ModelPreviewPicture
                class="block aspect-[3/2] h-auto w-full object-cover"
                src={`/home/${system.id}.light.webp`}
                darkSrc={`/home/${system.id}.dark.webp`}
                width={1200}
                height={800}
                alt={t(`home.explore.${system.id}.alt`)}
              />
              <div class="grid gap-3 p-5 sm:p-6">
                <p class="m-0 font-mono text-sm text-muted-foreground">
                  {system.number} / {t(`home.explore.${system.id}.label`)}
                </p>
                <h3 class="m-0 text-2xl font-semibold">
                  {t(`home.explore.${system.id}.title`)}
                </h3>
                <p class="m-0 leading-relaxed text-muted-foreground">
                  {t(`home.explore.${system.id}.description`)}
                </p>
                <p
                  class="m-0 text-sm leading-relaxed text-muted-foreground"
                  data-testid={`home-explore-${system.id}-category-summary`}
                >
                  {t(`home.explore.${system.id}.categorySummary`)}
                </p>
                <a
                  class={`inline-flex min-h-11 items-center gap-2 justify-self-start ${inlineLinkClass}`}
                  href={system.href}
                >
                  {t(`home.explore.${system.id}.cta`)}
                  <ArrowRightIcon class="size-4" aria-hidden="true" />
                </a>
              </div>
            </Card>
          ))
        }
      </div>
    </section>

    <section
      class="grid gap-8"
      aria-labelledby="home-workflow-title"
      data-testid="home-workflow"
    >
      <h2
        class="m-0 text-3xl font-semibold leading-tight"
        id="home-workflow-title"
      >
        {t('home.workflow.title')}
      </h2>
      <ol class="m-0 grid list-none gap-8 p-0 md:grid-cols-3">
        {
          steps.map(({ id, Icon }, index) => (
            <li class="grid content-start gap-3 border-t border-border pt-5">
              <div class="flex items-center justify-between text-primary-strong dark:text-primary">
                <>
                  <Icon class="size-6" aria-hidden="true" />
                  <span class="font-mono text-sm">0{index + 1}</span>
                </>
              </div>
              <h3 class="m-0 text-xl font-semibold">
                {t(`home.workflow.${id}.title`)}
              </h3>
              <p class="m-0 leading-relaxed text-muted-foreground">
                {t(`home.workflow.${id}.description`)}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section
      class="grid items-center gap-5 rounded-container bg-muted p-6 sm:p-8 md:grid-cols-[1fr_auto]"
      aria-labelledby="home-guide-title"
      data-testid="home-guide"
    >
      <div class="grid gap-2">
        <h2 class="m-0 text-2xl font-semibold" id="home-guide-title">
          {t('home.guide.title')}
        </h2>
        <p class="m-0 max-w-2xl leading-relaxed text-muted-foreground">
          {t('home.guide.description')}
        </p>
      </div>
      <Button
        as="a"
        href={`${docsPath}#assembly-direct-placement-align`}
        variant="outline"
        class="justify-self-start no-underline">{t('home.guide.cta')}</Button
      >
    </section>
    <Card
      as="section"
      class="grid gap-6 p-5 sm:grid-cols-[auto_minmax(0,1fr)] sm:items-center sm:p-8"
      aria-labelledby="home-maker-title"
      data-testid="home-maker"
    >
      <div>
        <img
          class="mx-auto aspect-square w-24 rounded-2xl border border-border bg-muted object-cover sm:mx-0 sm:w-28"
          src="/about/blesscat.png"
          width="640"
          height="640"
          loading="lazy"
          alt={t('home.maker.portraitAlt')}
        />
      </div>
      <div class="grid gap-4">
        <p
          class="m-0 font-mono text-sm font-semibold tracking-[0.12em] text-primary-strong uppercase dark:text-primary"
        >
          {t('home.maker.eyebrow')}
        </p>
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="home-maker-title"
        >
          {t('home.maker.title')}
        </h2>
        <p class="m-0 leading-relaxed text-muted-foreground">
          {t('home.maker.body')}
        </p>
        <p class="m-0 text-sm font-semibold text-foreground">
          {t('home.maker.status')}
        </p>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-3">
          <Button
            as="a"
            href={aboutPath}
            variant="outline"
            size="sm"
            class="min-h-11 border-primary-strong/60 bg-transparent text-primary-strong hover:bg-primary-strong/5 hover:text-primary-strong no-underline dark:border-primary/60 dark:bg-transparent dark:text-primary dark:hover:bg-primary/10"
          >
            {t('home.maker.aboutCta')}
          </Button>
          <a
            class="grid size-11 place-items-center rounded-full border border-border-field text-foreground transition-colors duration-200 hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline"
            href="https://github.com/blesscat"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('home.maker.githubCta')}
          >
            <BrandGithubIcon class="size-4.5" aria-hidden="true" />
          </a>
          <a
            class="grid size-11 place-items-center rounded-full border border-border-field text-foreground transition-colors duration-200 hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline"
            href="mailto:blesscat@gmail.com"
            aria-label={t('home.maker.emailCta')}
          >
            <MailIcon class="size-4.5" aria-hidden="true" />
          </a>
          {
            supportProviders.length > 0 && (
              <Button
                type="button"
                variant="neon"
                size="sm"
                class="min-h-11 no-underline"
                data-support-dialog-open
                data-testid="home-maker-support-trigger"
                aria-controls="support-dialog"
                aria-haspopup="dialog"
              >
                {t('home.maker.supportCta')}
              </Button>
            )
          }
        </div>
      </div>
    </Card>
  </div>
</SiteLayout>
