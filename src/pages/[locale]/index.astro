---
import SiteLayout from '../../layouts/SiteLayout.astro'
import '../../styles/starwind.css'
import { Button } from '../../components/starwind/button'
import { Card } from '../../components/starwind/card'
import ModelPreviewPicture from '../../components/ModelPreviewPicture.astro'
import BrowserIcon from '@tabler/icons/outline/browser.svg'
import AdjustmentsIcon from '@tabler/icons/outline/adjustments-horizontal.svg'
import Rotate3dIcon from '@tabler/icons/outline/rotate-3d.svg'
import DownloadIcon from '@tabler/icons/outline/download.svg'
import BrandGithubIcon from '@tabler/icons/outline/brand-github.svg'
import MailIcon from '@tabler/icons/outline/mail.svg'
import { supportProviders } from '../../features/support/config'
import { SUPPORTED_LOCALES, isLocale, translate, type Locale } from '../../i18n'
import { localizedCadPathFor, publicPathFor } from '../../i18n/routes'

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}

const locale = Astro.props.locale as Locale
if (!isLocale(locale)) throw new Error(`UNSUPPORTED_LOCALE:${locale}`)
const t = (key: string) => translate(locale, key)
const deskBoardPath = localizedCadPathFor(locale, 'opengrid', 'desk')
const wallBoardPath = localizedCadPathFor(locale, 'opengrid', 'wall')
const modelsPath = publicPathFor(locale, 'models')
const docsPath = publicPathFor(locale, 'docs')
const aboutPath = publicPathFor(locale, 'about')
const deskFlowPath = `/docs/desk-system/desk-system-flow.${locale}.svg`
const deskFlowDarkPath = `/docs/desk-system/desk-system-flow.${locale}-dark.svg`

const inlineLinkClass =
  'font-semibold text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground focus-visible:ring-3 focus-visible:ring-outline/50'

/* Presentational-only title treatment: highlight the action phrase and
   stack the headline on two lines. The translated wording itself is
   unchanged. */
const homeTitleHtml = (() => {
  const highlighted = t('home.title').replace(
    /(挑個模型調一調|Pick a model, tweak it)/,
    '<span class="text-primary-strong dark:text-primary">$1</span>',
  )
  const parts = highlighted.match(/^(.*?)<span[^>]*>([^<]*)<\/span>\s*(.*)$/)
  if (!parts) return highlighted
  const [, before, phrase, after] = parts
  return `${before}<span class="text-primary-strong dark:text-primary">${phrase}</span><br />${after}`
})()

const heroBadges = [
  { key: 'home.badge.noInstall', testid: 'home-badge-no-install' },
  { key: 'home.badge.inBrowser', testid: 'home-badge-in-browser' },
  { key: 'home.badge.freeForever', testid: 'home-badge-free-forever' },
] as const

const fileCardRows = [
  { labelKey: 'home.fileCard.whereLabel', valueKey: 'home.fileCard.whereValue' },
  {
    labelKey: 'home.fileCard.downloadLabel',
    valueKey: 'home.fileCard.downloadValue',
  },
  { labelKey: 'home.fileCard.statusLabel', valueKey: 'home.fileCard.statusValue' },
] as const
---

<SiteLayout
  {locale}
  title={t('home.metaTitle')}
  description={t('home.metaDescription')}
>
  <div class="grid gap-24 lg:gap-32">
    <section
      class="grid items-center gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-12"
      aria-labelledby="home-title"
      data-testid="home-hero"
    >
      <div class="grid gap-5 lg:order-2">
        <ul
          class="m-0 flex list-none flex-wrap gap-2 p-0"
          data-testid="home-hero-badges"
        >
          {
            heroBadges.map((badge) => (
              <li
                class="rounded-full bg-primary-soft px-3.5 py-1.5 text-sm font-semibold text-primary-strong dark:text-primary"
                data-testid={badge.testid}
              >
                {t(badge.key)}
              </li>
            ))
          }
        </ul>
        <h1
          class="m-0 max-w-2xl text-4xl font-semibold leading-tight sm:text-5xl"
          id="home-title"
          set:html={homeTitleHtml}
        />
        <p class="m-0 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          {t('home.description')}
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button
            as="a"
            href={modelsPath}
            variant="neon"
            size="lg"
            class="w-full no-underline sm:w-auto"
          >
            {t('home.primaryCta')}
          </Button>
          <Button
            as="a"
            href={docsPath}
            variant="outline"
            size="lg"
            class="w-full border-primary-strong/60 bg-transparent text-primary-strong hover:bg-primary-strong/5 hover:text-primary-strong no-underline dark:border-primary/60 dark:bg-transparent dark:text-primary dark:hover:bg-primary/10 sm:w-auto"
          >
            {t('home.secondaryCta')}
          </Button>
        </div>
        <p class="m-0 text-sm leading-normal text-muted-foreground">
          <a class={inlineLinkClass} href={deskBoardPath}
            >{t('home.heroNote')}</a
          >
        </p>
        <Card
          size="sm"
          class="grid gap-3 p-4 shadow-sm"
          data-testid="home-file-card"
        >
          <dl class="m-0 grid gap-2.5">
            {
              fileCardRows.map((row) => (
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <dt class="font-mono text-sm font-semibold tracking-wide text-muted-foreground">
                    {t(row.labelKey)}
                  </dt>
                  <dd class="m-0 text-right text-sm font-semibold text-foreground">
                    {t(row.valueKey)}
                  </dd>
                </div>
              ))
            }
          </dl>
        </Card>
      </div>

      <figure
        class="m-0 grid content-start gap-3 rounded-container p-3 lg:order-1"
        data-testid="home-hero-visual"
      >
        <ModelPreviewPicture
          class="aspect-[16/10] h-full w-full rounded-card border border-border bg-muted object-cover shadow-soft"
          src="/model-previews/opengrid-desk.webp"
          darkSrc="/model-previews/opengrid-desk-dark.webp"
          width="640"
          height="400"
          loading="eager"
          alt={t('home.heroVisual.boardAlt')}
        />
        <figcaption class="text-sm leading-normal text-muted-foreground">
          {t('home.heroVisual.caption')}
        </figcaption>
      </figure>
    </section>

    <section
      class="grid gap-10"
      aria-labelledby="home-capabilities-title"
      data-testid="home-capabilities"
    >
      <header class="grid justify-items-center gap-2 text-center">
        <p
          class="m-0 font-mono text-sm font-semibold tracking-[0.12em] text-muted-foreground uppercase"
        >
          {t('home.features')}
        </p>
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="home-capabilities-title"
        >
          {t('home.capabilities.title')}
        </h2>
        <p class="m-0 max-w-2xl leading-relaxed text-muted-foreground">
          {t('home.capabilities.description')}
        </p>
      </header>
      <div
        class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"
        aria-label={t('home.features')}
      >
        <Card
          as="article"
          size="sm"
          class="grid gap-3 p-4 shadow-sm"
        >
          <div class="flex items-center gap-2.5">
            <span
              class="grid size-9 shrink-0 place-items-center rounded-lg border border-success/30 bg-success-soft text-success dark:text-success"
            >
              <BrowserIcon class="size-5" aria-hidden="true" />
            </span>
            <h3 class="m-0 text-lg font-semibold leading-tight">
              {t('home.feature.browser.title')}
            </h3>
          </div>
          <div class="h-px w-full bg-border" aria-hidden="true"></div>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('home.feature.browser.description')}
          </p>
        </Card>
        <Card
          as="article"
          size="sm"
          class="grid gap-3 p-4 shadow-sm"
        >
          <div class="flex items-center gap-2.5">
            <span
              class="grid size-9 shrink-0 place-items-center rounded-lg border border-amber-600/30 bg-amber-500/10 text-amber-700 dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-400"
            >
              <AdjustmentsIcon class="size-5" aria-hidden="true" />
            </span>
            <h3 class="m-0 text-lg font-semibold leading-tight">
              {t('home.feature.parameters.title')}
            </h3>
          </div>
          <div class="h-px w-full bg-border" aria-hidden="true"></div>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('home.feature.parameters.description')}
          </p>
        </Card>
        <Card
          as="article"
          size="sm"
          class="grid gap-3 p-4 shadow-sm"
        >
          <div class="flex items-center gap-2.5">
            <span
              class="grid size-9 shrink-0 place-items-center rounded-lg border border-primary/30 bg-primary-soft text-primary-strong dark:text-primary"
            >
              <Rotate3dIcon class="size-5" aria-hidden="true" />
            </span>
            <h3 class="m-0 text-lg font-semibold leading-tight">
              {t('home.feature.preview.title')}
            </h3>
          </div>
          <div class="h-px w-full bg-border" aria-hidden="true"></div>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('home.feature.preview.description')}
          </p>
        </Card>
        <Card
          as="article"
          size="sm"
          class="grid gap-3 p-4 shadow-sm"
        >
          <div class="flex items-center gap-2.5">
            <span
              class="grid size-9 shrink-0 place-items-center rounded-lg border border-primary/30 bg-primary/10 text-primary"
            >
              <DownloadIcon class="size-5" aria-hidden="true" />
            </span>
            <h3 class="m-0 text-lg font-semibold leading-tight">
              {t('home.feature.export.title')}
            </h3>
          </div>
          <div class="h-px w-full bg-border" aria-hidden="true"></div>
          <p class="m-0 text-sm leading-normal text-muted-foreground">
            {t('home.feature.export.description')}
          </p>
        </Card>
      </div>
    </section>

    <Card
      as="section"
      class="grid gap-8 p-5 shadow-lg sm:p-8"
      aria-labelledby="home-desk-title"
      data-testid="home-desk-system"
    >
      <header class="grid justify-items-center gap-3 text-center">
        <p
          class="m-0 font-mono text-sm font-semibold tracking-[0.12em] text-primary-strong uppercase dark:text-primary"
        >
          {t('home.desk.eyebrow')}
        </p>
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="home-desk-title"
        >
          {t('home.desk.title')}
        </h2>
        <p class="m-0 max-w-3xl leading-relaxed text-muted-foreground">
          {t('home.desk.description')}
        </p>
      </header>

      <div class="grid gap-8">
        <figure class="m-0 grid gap-3">
          <ModelPreviewPicture
            class="w-full rounded-xl border border-border bg-muted"
            src={deskFlowPath}
            darkSrc={deskFlowDarkPath}
            width={1400}
            height={820}
            loading="lazy"
            alt={t('home.desk.flowAlt')}
          />
          <figcaption class="text-sm leading-normal text-muted-foreground">
            {t('home.desk.flowCaption')}
          </figcaption>
        </figure>

        <div class="grid gap-5">
          <ol class="m-0 grid gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
            <li class="grid justify-items-center gap-3 text-center">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-full border-2 border-primary font-semibold text-primary-strong dark:text-primary"
                >1</span
              >
              <div class="grid gap-1">
                <h3 class="m-0 font-semibold">
                  {t('home.desk.step.board.title')}
                </h3>
                <p class="m-0 text-sm leading-normal text-muted-foreground">
                  {t('home.desk.step.board.description')}
                </p>
              </div>
            </li>
            <li class="grid justify-items-center gap-3 text-center">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-full border-2 border-primary font-semibold text-primary-strong dark:text-primary"
                >2</span
              >
              <div class="grid gap-1">
                <h3 class="m-0 font-semibold">
                  {t('home.desk.step.snap.title')}
                </h3>
                <p class="m-0 text-sm leading-normal text-muted-foreground">
                  {t('home.desk.step.snap.description')}
                </p>
              </div>
            </li>
            <li class="grid justify-items-center gap-3 text-center">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-full border-2 border-amber-400 font-semibold text-amber-700 dark:text-amber-400"
                >3</span
              >
              <div class="grid gap-1">
                <h3 class="m-0 font-semibold">
                  {t('home.desk.step.locating.title')}
                </h3>
                <p class="m-0 text-sm leading-normal text-muted-foreground">
                  {t('home.desk.step.locating.description')}
                </p>
              </div>
            </li>
            <li class="grid justify-items-center gap-3 text-center">
              <span
                class="grid size-10 shrink-0 place-items-center rounded-full border-2 border-primary font-semibold text-primary-strong dark:text-primary"
                >4</span
              >
              <div class="grid gap-1">
                <h3 class="m-0 font-semibold">
                  {t('home.desk.step.container.title')}
                </h3>
                <p class="m-0 text-sm leading-normal text-muted-foreground">
                  {t('home.desk.step.container.description')}
                </p>
              </div>
            </li>
          </ol>
          <Button
            as="a"
            href={docsPath}
            variant="outline"
            class="justify-self-center no-underline"
            >{t('home.desk.docsCta')}</Button
          >
        </div>
      </div>
    </Card>

    <section
      class="grid gap-6"
      aria-labelledby="home-explore-title"
      data-testid="home-explore"
    >
      <header class="grid justify-items-center gap-2 text-center">
        <p
          class="m-0 font-mono text-sm font-semibold uppercase tracking-[0.12em] text-muted-foreground"
        >
          {t('home.explore.eyebrow')}
        </p>
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="home-explore-title"
        >
          {t('home.explore.title')}
        </h2>
      </header>
      <div class="grid gap-6 md:grid-cols-2">
        <Card
          as="article"
          class="grid gap-4 p-4 shadow-sm sm:grid-cols-[minmax(9rem,0.85fr)_minmax(0,1.15fr)] sm:items-center lg:grid-cols-1"
        >
          <ModelPreviewPicture
            class="aspect-[16/10] w-full rounded-xl border border-border bg-muted object-cover"
            src="/model-previews/opengrid-desk.webp"
            darkSrc="/model-previews/opengrid-desk-dark.webp"
            width="640"
            height="400"
            loading="lazy"
            alt={t('home.explore.desk.alt')}
          />
          <div class="grid gap-2">
            <h3 class="m-0 text-xl font-semibold leading-tight">
              {t('home.explore.desk.title')}
            </h3>
            <p class="m-0 text-sm leading-normal text-muted-foreground">
              {t('home.explore.desk.description')}
            </p>
            <a class={inlineLinkClass} href={deskBoardPath}
              >{t('home.explore.desk.cta')}</a
            >
          </div>
        </Card>
        <Card
          as="article"
          class="grid gap-4 p-4 shadow-sm sm:grid-cols-[minmax(9rem,0.85fr)_minmax(0,1.15fr)] sm:items-center lg:grid-cols-1"
        >
          <ModelPreviewPicture
            class="aspect-[16/10] w-full rounded-xl border border-border bg-muted object-cover"
            src="/model-previews/opengrid-wall.webp"
            darkSrc="/model-previews/opengrid-wall-dark.webp"
            width="640"
            height="400"
            loading="lazy"
            alt={t('home.explore.wall.alt')}
          />
          <div class="grid gap-2">
            <h3 class="m-0 text-xl font-semibold leading-tight">
              {t('home.explore.wall.title')}
            </h3>
            <p class="m-0 text-sm leading-normal text-muted-foreground">
              {t('home.explore.wall.description')}
            </p>
            <a class={inlineLinkClass} href={wallBoardPath}
              >{t('home.explore.wall.cta')}</a
            >
          </div>
        </Card>
      </div>
    </section>

    <Card
      as="section"
      class="grid gap-6 p-5 shadow-lg sm:grid-cols-[auto_minmax(0,1fr)] sm:items-center sm:p-8"
      aria-labelledby="home-maker-title"
      data-testid="home-maker"
    >
      <img
        class="mx-auto aspect-square w-24 rounded-2xl border border-border bg-muted object-cover sm:mx-0 sm:w-28"
        src="/about/blesscat.png"
        width="640"
        height="640"
        loading="lazy"
        alt={t('home.maker.portraitAlt')}
      />
      <div class="grid gap-4">
        <p
          class="m-0 font-mono text-sm font-semibold tracking-[0.12em] text-primary-strong uppercase dark:text-primary"
        >
          {t('home.maker.eyebrow')}
        </p>
        <h2
          class="m-0 text-3xl font-semibold leading-tight"
          id="home-maker-title"
        >
          {t('home.maker.title')}
        </h2>
        <p class="m-0 leading-relaxed text-muted-foreground">
          {t('home.maker.body')}
        </p>
        <p class="m-0 text-sm font-semibold text-foreground">
          {t('home.maker.status')}
        </p>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-3">
          <Button
            as="a"
            href={aboutPath}
            variant="outline"
            size="sm"
            class="border-primary-strong/60 bg-transparent text-primary-strong hover:bg-primary-strong/5 hover:text-primary-strong no-underline dark:border-primary/60 dark:bg-transparent dark:text-primary dark:hover:bg-primary/10"
          >
            {t('home.maker.aboutCta')}
          </Button>
          <a
            class="grid size-10 place-items-center rounded-lg border border-border-field text-foreground transition-colors hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline/50"
            href="https://github.com/blesscat"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('home.maker.githubCta')}
          >
            <BrandGithubIcon class="size-4.5" aria-hidden="true" />
          </a>
          <a
            class="grid size-10 place-items-center rounded-lg border border-border-field text-foreground transition-colors hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline/50"
            href="mailto:blesscat@gmail.com"
            aria-label={t('home.maker.emailCta')}
          >
            <MailIcon class="size-4.5" aria-hidden="true" />
          </a>
          {
            supportProviders.length > 0 && (
              <Button
                type="button"
                variant="ghost"
                size="sm"
                class={`${inlineLinkClass} h-auto rounded-none px-0 py-0 text-left hover:bg-transparent`}
                data-support-dialog-open
                data-testid="home-maker-support-trigger"
                aria-controls="support-dialog"
                aria-haspopup="dialog"
              >
                {t('home.maker.supportCta')}
              </Button>
            )
          }
        </div>
      </div>
    </Card>

    <Card
      as="section"
      class="grid gap-4 bg-banner p-6 text-banner-foreground shadow-lg ring-0 sm:p-8"
      aria-labelledby="home-final-title"
    >
      <h2
        class="m-0 text-3xl font-semibold leading-tight"
        id="home-final-title"
      >
        {t('home.final.title')}
      </h2>
      <p class="m-0 max-w-2xl leading-relaxed text-banner-foreground/85">
        {t('home.final.description')}
      </p>
      <p class="m-0">
        {
          supportProviders.length > 0 ? (
            <Button
              type="button"
              variant="neon"
              size="lg"
              class="no-underline"
              data-support-dialog-open
              data-testid="home-final-cta"
              aria-controls="support-dialog"
              aria-haspopup="dialog"
            >
              {t('home.final.cta')}
            </Button>
          ) : (
            <Button
              as="a"
              href={aboutPath}
              variant="neon"
              size="lg"
              class="no-underline"
              data-testid="home-final-cta"
            >
              {t('home.final.cta')}
            </Button>
          )
        }
      </p>
    </Card>
  </div>
</SiteLayout>
