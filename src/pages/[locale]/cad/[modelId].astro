---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import CadAttributionNotice from '../../../components/cad/CadAttributionNotice.astro'
import CadSystemContextLabel from '../../../components/cad/CadSystemContextLabel.svelte'
import CadWorkspace from '../../../components/cad/CadWorkspace.svelte'
import { getOpenGridAttribution } from '../../../features/cad/attribution/opengrid'
import {
  displayParameterLabel,
  exportFormatsLineKeyFor,
  getModelDefinition,
  modelDefinitions,
  parameterStaticSummaryKeysFor,
  unitLabelFor,
} from '../../../features/cad/model-catalog'
import {
  SUPPORTED_LOCALES,
  isLocale,
  translate,
  type Locale,
} from '../../../i18n'
import type { ModelId } from '../../../cad-contract/units'
import { publicPathFor } from '../../../i18n/routes'

export function getStaticPaths() {
  return SUPPORTED_LOCALES.flatMap((locale) =>
    modelDefinitions.map((definition) => ({
      params: { locale, modelId: definition.id },
      props: { locale, modelId: definition.id },
    })),
  )
}

const locale = Astro.props.locale as Locale
const modelId = Astro.props.modelId as ModelId
if (!isLocale(locale)) throw new Error(`UNSUPPORTED_LOCALE:${locale}`)

const definition = getModelDefinition(modelId)
if (!definition) throw new Error(`UNKNOWN_MODEL_ID:${modelId}`)

const t = (key: string, values?: Record<string, string | number | boolean>) =>
  translate(locale, key, values)
const modelName = t(`models.model.${definition.id}.name`)
const modelDescription = t(`models.model.${definition.id}.description`)
const attribution = getOpenGridAttribution(modelId)

function parameterSummary() {
  if (definition.parameterSchema.length === 0) {
    const staticSummaries = parameterStaticSummaryKeysFor(definition)
      .map((key) => t(key))
      .filter((summary) => !summary.startsWith('⟦'))
    if (staticSummaries.length > 0) return staticSummaries
    return [t('cad.fixedParameters')]
  }

  return definition.parameterSchema.map((field) =>
    t('models.parameterRange', {
      label: displayParameterLabel(field, locale),
      min: field.min,
      max: field.max,
      unit: unitLabelFor(locale, field.unit),
    }),
  )
}
---

<SiteLayout
  {locale}
  fullWidth
  cadWorkspace
  title={t('cad.pageTitle', { name: modelName })}
  description={modelDescription}
>
  <section
    aria-labelledby="cad-title"
    class:list={['cad-page', attribution && 'has-attribution']}
    data-dev-actions={import.meta.env.DEV || undefined}
  >
    <header
      class="mb-3 flex flex-wrap items-center justify-between gap-3"
      data-testid="cad-header"
    >
      <div class="min-w-0">
        <div class="min-h-5">
          <CadSystemContextLabel
            client:only="svelte"
            modelId={modelId}
            locale={locale}
          />
        </div>
        <h1
          class="m-0 break-words text-xl font-semibold leading-tight sm:text-2xl"
          id="cad-title"
        >
          {t('cad.currentlyEditing', { name: modelName })}
        </h1>
      </div>
      <a
        class="rounded-lg border border-border-card bg-panel px-[0.8rem] py-[0.6rem] text-base text-ink no-underline hover:bg-page focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus"
        href={publicPathFor(locale, 'models')}
      >
        {t('common.backToModels')}
      </a>
    </header>
    <div
      class="cad-loading-shell mt-3 grid items-start gap-4"
      id="cad-fallback"
    >
      <div
        class="cad-loading-summary rounded-2xl border border-border-card bg-panel p-4"
      >
        <h2 class="mb-4 text-lg font-semibold leading-tight">
          {t('cad.loading', { name: modelName })}
        </h2>
        <p class="mb-4 leading-normal">{modelDescription}</p>
        <section class="mb-4 grid gap-2" data-testid="cad-static-summary">
          <h2 class="m-0 text-xl font-semibold leading-tight">
            {t('cad.staticSummary')}
          </h2>
          <h3 class="m-0 text-base font-semibold">
            {t('cad.parametersHeading')}
          </h3>
          <ul class="m-0 grid gap-1 pl-5 leading-normal">
            {parameterSummary().map((summary) => <li>{summary}</li>)}
          </ul>
          <p class="m-0 leading-normal">
            {
              t('cad.exportFormats', {
                formats: t(exportFormatsLineKeyFor(definition)),
              })
            }
          </p>
        </section>
        <p class="mb-4 leading-normal">{t('cad.requirements')}</p>
        <p class="mb-0">
          <a
            class="text-ink underline underline-offset-4"
            href={publicPathFor(locale, 'models')}
            >{t('common.backToModelsArrow')}</a
          >
        </p>
      </div>
      <div
        class="cad-loading-preview flex items-center justify-center rounded-2xl border border-border-card bg-viewport p-4 text-center text-sm text-muted-foreground"
        data-testid="cad-loading-preview"
      >
        {t('cad.loading', { name: modelName })}
      </div>
    </div>
    <CadWorkspace client:only="svelte" modelId={modelId} locale={locale} />
    {attribution && <CadAttributionNotice {locale} {attribution} />}
  </section>
</SiteLayout>

<style>
  .cad-page {
    --cad-mobile-action-height: 112px;
  }
  @media (max-width: 380px) {
    .cad-page[data-dev-actions] {
      --cad-mobile-action-height: 160px;
    }
  }
  .cad-loading-shell[hidden] {
    display: none;
  }
  .cad-loading-preview {
    height: calc(100dvh - 16rem);
  }
  @media (min-width: 761px) {
    .cad-page {
      --cad-desktop-height: clamp(120px, calc(100dvh - 260px), 520px);
    }
    .cad-page.has-attribution {
      --cad-desktop-height: clamp(120px, calc(100dvh - 360px), 520px);
    }
    .cad-page :global([data-testid='cad-viewport']) {
      height: var(--cad-desktop-height);
    }
    .cad-page :global([data-testid='cad-workspace-panel']) {
      max-height: var(--cad-desktop-height);
    }
    .cad-page :global([data-testid='cad-attribution']) {
      max-height: 96px;
      overflow-y: auto;
      margin-block: 12px 0;
    }

    .cad-loading-shell {
      grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
    }
    .cad-loading-summary {
      max-height: var(--cad-desktop-height);
      overflow-y: auto;
    }
    .cad-loading-preview {
      height: var(--cad-desktop-height);
    }
  }
  @media (min-width: 761px) and (max-height: 600px) {
    .cad-page,
    .cad-page.has-attribution {
      --cad-desktop-height: clamp(96px, calc(100dvh - 280px), 520px);
    }
    .cad-page :global([data-testid='cad-attribution']) {
      max-height: 48px;
    }
  }
  @media (max-width: 760px) {
    .cad-loading-preview {
      margin-top: var(--cad-mobile-action-height);
      grid-row: 1;
    }
  }
</style>
