---
import SiteLayout from '../../../layouts/SiteLayout.astro'
import Playground from '../../../components/cad/playground/Playground.svelte'
import { isLocale, translate, type Locale } from '../../../i18n'
import { publicPathFor } from '../../../i18n/routes'

export function getStaticPaths() {
  return [
    { params: { locale: 'zh-Hant' }, props: { locale: 'zh-Hant' } },
    { params: { locale: 'en' }, props: { locale: 'en' } },
  ]
}

const locale = Astro.props.locale as Locale
if (!isLocale(locale)) throw new Error(`UNSUPPORTED_LOCALE:${locale}`)
const t = (key: string) => translate(locale, key)
---

<SiteLayout
  {locale}
  fullWidth
  cadWorkspace
  title={t('playground.title')}
  description={t('playground.description')}
>
  <section class="playground-page" aria-labelledby="playground-title">
    <header class="mb-4">
      <a
        class="text-base text-ink underline underline-offset-4"
        href={publicPathFor(locale, 'models')}
      >
        {t('common.backToModels')}
      </a>
    </header>
    <Playground client:only="svelte" {locale} />
  </section>
</SiteLayout>

<style>
  /*
   * Desktop: the page fills the window below the sticky site header, and the
   * playground workspace row takes whatever height the toolbar and notices
   * leave. On short windows the row keeps a floor that still fits whole below
   * the header, and the page scrolls instead.
   */
  @media (width > 760px) {
    .playground-page {
      /* Mirrors SiteLayout's `[data-cad-shell] > main` vertical padding. */
      --playground-shell-padding-top: 16px;
      --playground-shell-padding-bottom: 16px;
      --playground-below-header: calc(100dvh - var(--site-header-height));
      --playground-workspace-min-height: min(
        18rem,
        calc(
          var(--playground-below-header) -
            var(--playground-shell-padding-bottom)
        )
      );
      display: flex;
      flex-direction: column;
      min-height: calc(
        var(--playground-below-header) - var(--playground-shell-padding-top) -
          var(--playground-shell-padding-bottom)
      );
    }
  }
  @media (width > 760px) and (max-height: 600px) {
    .playground-page {
      --playground-shell-padding-top: 8px;
      --playground-shell-padding-bottom: 8px;
    }
  }
</style>
