---
import { Card } from '../starwind/card'
import { Button } from '../starwind/button'
import { Separator } from '../starwind/separator'
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from '../starwind/dialog'
import ModelPreviewPicture from '../ModelPreviewPicture.astro'
import {
  displayParameterLabel,
  modelSelectionLabelFor,
  parameterPresentationFor,
  parameterStaticSummaryKeysFor,
  unitLabelFor,
  type ModelDefinition,
  type ModelPreviewImage,
} from '../../features/cad/model-catalog'
import { translate, type Locale } from '../../i18n'
import { localizedCadPathFor } from '../../i18n/routes'

interface Props {
  definition: ModelDefinition<ModelPreviewImage>
  locale: Locale
}

const { definition, locale } = Astro.props
const t = (key: string, values?: Record<string, string | number | boolean>) =>
  translate(locale, key, values)

function previewImage() {
  if (!definition.previewImage) {
    throw new Error(`MODEL_PREVIEW_MISSING:${definition.id}`)
  }
  return definition.previewImage
}

function modelText(field: 'name' | 'description' | 'alt') {
  return t(`models.model.${definition.id}.${field}`)
}

/* Category badge: text + tinted pill (never color alone). Container rides on
   the coral soft tint, base on mint, everything else stays neutral. */
function categoryBadgeClassFor(
  category: NonNullable<ModelDefinition['partCategory']>,
): string {
  if (category === 'container')
    return 'bg-primary-soft text-primary-hover dark:text-primary'
  if (category === 'base') return 'bg-success-soft text-success'
  return 'bg-muted text-muted-foreground'
}

function translatedSummaryFor(key: string | undefined): string | undefined {
  if (!key) return undefined
  const summary = t(key)
  if (summary.startsWith('⟦')) return undefined
  return summary
}

function translatedStaticSummariesFor(): string[] {
  return parameterStaticSummaryKeysFor(definition)
    .map((key) => translatedSummaryFor(key))
    .filter((summary): summary is string => summary !== undefined)
}

function parameterSummary(): string[] {
  const presentation = parameterPresentationFor(definition)
  const staticSummaries = translatedStaticSummariesFor()
  if (staticSummaries.length > 0) return staticSummaries

  if (presentation.kind === 'fixed') {
    return [t('models.fixedParameters')]
  }

  if (definition.parameterSchema.length === 0) {
    return [t('models.adjustableSettingsMultiple')]
  }

  return definition.parameterSchema.map((field) =>
    t('models.parameterRange', {
      label: displayParameterLabel(field, locale),
      min: field.min,
      max: field.max,
      unit: unitLabelFor(locale, field.unit),
    }),
  )
}

function detailsDialogId(): string {
  return `model-details-${definition.id}-${definition.systemContext ?? 'legacy'}`
}

/* Warm system tag tint: Desk on coral soft, Wall on mint soft, HSW neutral. */
function systemTagClass(): string {
  if (definition.systemContext === 'desk')
    return 'bg-primary-soft text-primary-hover dark:text-primary'
  if (definition.systemContext === 'wall') return 'bg-success-soft text-success'
  return 'bg-muted text-muted-foreground'
}

function systemTag(): string | null {
  if (definition.systemContext === 'desk') return t('models.context.desk')
  if (definition.systemContext === 'wall') return t('models.context.wall')
  if (definition.id === 'hsw-cell') return 'HSW'
  return null
}

const preview = previewImage()
const selectionLabel = t(modelSelectionLabelFor(definition))
const description = modelText('description')
const previewAlt = modelText('alt')
const parameterDetails = parameterSummary()
const dialogId = detailsDialogId()
const cadPath = localizedCadPathFor(
  locale,
  definition.id,
  definition.systemContext,
)
const systemTagText = systemTag()
const categoryText = definition.partCategory
  ? t(`models.category.${definition.partCategory}`)
  : null
const categoryClass = definition.partCategory
  ? categoryBadgeClassFor(definition.partCategory)
  : null
---

<Card
  as="article"
  size="sm"
  class="grid gap-3 p-3 sm:p-4"
  data-model-id={definition.id}
  data-entry-key={`${definition.id}-${definition.systemContext ?? 'legacy'}`}
  data-system-context={definition.systemContext}
>
  <div
    class="grid aspect-[16/10] place-items-center overflow-hidden rounded-lg border border-border bg-muted"
    data-testid="model-preview"
  >
    <div
      class="p-4 text-center text-sm text-muted-foreground"
      data-testid="model-preview-fallback"
      hidden
      role="img"
      aria-label={previewAlt}
    >
      {t('models.previewUnavailable')}
    </div>
    <ModelPreviewPicture
      src={preview.src}
      darkSrc={preview.darkSrc}
      width={preview.width}
      height={preview.height}
      alt={previewAlt}
      loading="lazy"
      class="h-full w-full object-contain"
      onerror="if (this.offsetParent) { this.hidden = true; this.closest('[data-testid=model-preview]')?.querySelector('[data-testid=model-preview-fallback]')?.removeAttribute('hidden') }"
    />
  </div>
  {
    definition.systemContext ? (
      <h4 class="m-0 break-words text-2xl font-semibold leading-tight">
        {selectionLabel}
      </h4>
    ) : (
      <h3 class="m-0 break-words text-2xl font-semibold leading-tight">
        {selectionLabel}
      </h3>
    )
  }
  {
    (systemTagText || categoryText) && (
      <div class="-mt-1 flex w-fit flex-wrap items-center gap-1.5">
        {systemTagText && (
          <span
            class={`rounded-full px-2.5 py-1 text-xs font-semibold ${systemTagClass()}`}
            data-testid="model-system-tag"
          >
            {systemTagText}
          </span>
        )}
        {categoryText && categoryClass && (
          <span
            class={`rounded-full px-2.5 py-1 text-xs font-semibold ${categoryClass}`}
            data-testid="model-category-badge"
            data-part-category={definition.partCategory}
          >
            {categoryText}
          </span>
        )}
      </div>
    )
  }
  <p class="m-0 text-sm leading-normal text-muted-foreground">
    {description}
  </p>
  <div class="grid gap-2 text-sm leading-normal">
    <Dialog>
      <DialogTrigger
        class="inline-flex min-h-11 w-fit items-center rounded-full border border-border bg-background px-4 py-2 font-semibold text-foreground hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline"
        data-model-details-open={dialogId}
        aria-controls={dialogId}
        hidden
      >
        {t('models.details')}
      </DialogTrigger>
      <a
        class="inline-flex min-h-11 w-fit items-center rounded-full border border-border bg-background px-4 py-2 font-semibold text-foreground no-underline hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline"
        data-model-details-fallback
        href={cadPath}
      >
        {t('models.details')}
      </a>
      <DialogContent
        id={dialogId}
        class="max-h-[calc(100dvh-2rem)] w-[calc(100vw-2rem)] max-w-2xl overflow-hidden rounded-2xl border-border bg-card p-0 text-foreground"
        aria-labelledby={`${dialogId}-title`}
        data-testid="model-details-dialog"
        closeLabel={t('models.close')}
      >
        <div
          class="grid max-h-[calc(100dvh-2rem)] min-w-0 gap-5 overflow-y-auto p-5 sm:p-6"
          data-testid="model-details-scroll"
        >
          <DialogHeader class="min-w-0 items-start gap-0 text-left">
            <DialogTitle
              class="m-0 break-words text-2xl font-semibold leading-tight"
              id={`${dialogId}-title`}
            >
              {selectionLabel}
            </DialogTitle>
            <DialogDescription class="sr-only">
              {description}
            </DialogDescription>
          </DialogHeader>
          <Separator class="bg-border" />
          <section class="grid min-w-0 gap-2 text-sm leading-normal">
            <h3 class="m-0 text-lg font-semibold leading-tight">
              {t('models.parameters')}
            </h3>
            {
              /* Spec-table treatment: soft rounded panel with hairline row
                separators and mono tabular values (design spec-table). */
            }
            <ul
              class="m-0 grid list-none gap-0 overflow-hidden rounded-xl bg-muted p-0"
              data-testid="model-parameters-table"
            >
              {
                parameterDetails.map((summary) => (
                  <li class="break-words border-b border-border px-4 py-2.5 font-mono text-sm leading-normal tabular-nums text-ink last:border-b-0">
                    {summary}
                  </li>
                ))
              }
            </ul>
            <p class="m-0 break-words text-muted-foreground">
              {
                t('models.exportFormatsLine', {
                  label: t('models.exportFormats'),
                  value: t('models.exportFormatsValue'),
                })
              }
            </p>
          </section>
        </div>
      </DialogContent>
    </Dialog>
  </div>
  <Button
    as="a"
    href={cadPath}
    variant="outline"
    size="sm"
    class="justify-self-start no-underline"
    aria-label={t('models.editAria', {
      name: selectionLabel,
    })}
  >
    {t('models.edit')}
  </Button>
</Card>
