---
import { Button } from '../starwind/button'
import ModelCardPreview from './ModelCardPreview.astro'
import ModelCardDialog from './ModelCardDialog.astro'
import {
  displayParameterLabel,
  exportFormatsLineKeyFor,
  modelSelectionLabelFor,
  parameterPresentationFor,
  parameterStaticSummaryKeysFor,
  unitLabelFor,
  type ModelDefinition,
  type ModelPreviewImage,
} from '../../features/cad/model-catalog'
import { translate, type Locale } from '../../i18n'
import { localizedCadPathFor } from '../../i18n/routes'

interface Props {
  definition: ModelDefinition<ModelPreviewImage>
  locale: Locale
}

const { definition, locale } = Astro.props
const t = (key: string, values?: Record<string, string | number | boolean>) =>
  translate(locale, key, values)

function previewImage() {
  if (!definition.previewImage) {
    throw new Error(`MODEL_PREVIEW_MISSING:${definition.id}`)
  }
  return definition.previewImage
}

function modelText(field: 'name' | 'description' | 'alt') {
  return t(`models.model.${definition.id}.${field}`)
}

/* Catalog category selects a large container preview or a compact base/tool row. */
type CardVariant = 'hero' | 'big' | 'row'

function variantFor(category: ModelDefinition['partCategory']): CardVariant {
  if (category === 'base') return 'hero'
  if (category === 'container') return 'big'
  return 'row'
}

const variant = variantFor(definition.partCategory)

/* Split the localized selection label into a primary line and a secondary
   original-name line（設計稿容器卡：中文大字＋英文小字）. Series-relative
   labels stay the heading source of truth; names without a parenthesized
   suffix render as a single line. */
function splitDisplayName(fullName: string): {
  primary: string
  secondary: string | null
} {
  const match = fullName.match(/^(.*?)\s*[（(]\s*(.+?)\s*[)）]\s*$/)
  if (!match) return { primary: fullName, secondary: null }
  if (locale === 'zh-Hant') {
    return { primary: match[2] ?? fullName, secondary: match[1] || null }
  }
  return { primary: match[1] ?? fullName, secondary: match[2] || null }
}

function translatedSummaryFor(key: string | undefined): string | undefined {
  if (!key) return undefined
  const summary = t(key)
  if (summary.startsWith('⟦')) return undefined
  return summary
}

function translatedStaticSummariesFor(): string[] {
  return parameterStaticSummaryKeysFor(definition)
    .map((key) => translatedSummaryFor(key))
    .filter((summary): summary is string => summary !== undefined)
}

function parameterSummary(): string[] {
  const presentation = parameterPresentationFor(definition)
  const staticSummaries = translatedStaticSummariesFor()
  if (staticSummaries.length > 0) return staticSummaries

  if (presentation.kind === 'fixed') {
    return [t('models.fixedParameters')]
  }

  if (definition.parameterSchema.length === 0) {
    return [t('models.adjustableSettingsMultiple')]
  }

  return definition.parameterSchema.map((field) =>
    t('models.parameterRange', {
      label: displayParameterLabel(field, locale),
      min: field.min,
      max: field.max,
      unit: unitLabelFor(locale, field.unit),
    }),
  )
}

function detailsDialogId(): string {
  return `model-details-${definition.id}-${definition.systemContext ?? 'legacy'}`
}

function systemTag(): string | null {
  if (definition.systemContext === 'desk') return t('models.context.desk')
  if (definition.systemContext === 'wall') return t('models.context.wall')
  return null
}

const preview = previewImage()
const selectionLabel = t(modelSelectionLabelFor(definition))
const description = modelText('description')
const previewAlt = modelText('alt')
const parameterDetails = parameterSummary()
const dialogId = detailsDialogId()
const cadPath = localizedCadPathFor(
  locale,
  definition.id,
  definition.systemContext,
)
const systemTagText = systemTag()
const categoryText = definition.partCategory
  ? t(`models.category.${definition.partCategory}`)
  : null
function displayedName() {
  if (variant === 'big') return splitDisplayName(selectionLabel)
  return { primary: selectionLabel, secondary: null }
}
const { primary: primaryName, secondary: secondaryName } = displayedName()
const entryKey = `${definition.id}-${definition.systemContext ?? 'legacy'}`

function cardWrapperClass() {
  if (variant === 'big') {
    return 'grid min-w-0 content-start gap-3 rounded-card border border-border bg-card p-3'
  }
  return 'grid min-w-0 grid-cols-[72px_minmax(0,1fr)] items-start gap-3 rounded-card border border-border bg-card p-3 sm:grid-cols-[96px_minmax(0,1fr)]'
}
function previewBadge() {
  if (variant !== 'big' || !categoryText) return null
  return { text: categoryText, category: definition.partCategory ?? '' }
}
const wrapperClass = cardWrapperClass()
const previewBoxClass =
  'relative grid aspect-[8/5] place-items-center overflow-hidden rounded-img bg-viewport'
const triggerClass =
  'inline-flex min-h-11 items-center rounded-lg border border-border bg-card px-3 py-2 text-sm font-semibold text-foreground no-underline hover:bg-muted focus-visible:ring-3 focus-visible:ring-outline'
---

<article
  class={wrapperClass}
  data-model-id={definition.id}
  data-entry-key={entryKey}
  data-system-context={definition.systemContext}
  data-sw-card={variant === 'big' ? '' : undefined}
>
  <ModelCardPreview
    {preview}
    {previewAlt}
    fallbackLabel={t('models.previewUnavailable')}
    boxClass={previewBoxClass}
    picturePadding="p-0"
    overlayBadge={previewBadge()}
  />
  <div class="grid min-w-0 gap-2">
    <div class="grid min-w-0 gap-1">
      <h4 class="m-0 break-words text-base font-bold leading-snug">
        {primaryName}
      </h4>
      {
        secondaryName && (
          <span class="break-words text-sm text-muted-foreground">
            {secondaryName}
          </span>
        )
      }
    </div>
    <p
      class="m-0 break-words text-sm leading-relaxed text-muted-foreground"
      data-model-purpose
    >
      {description}
    </p>
    <div
      class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground"
    >
      {
        categoryText && variant !== 'big' && (
          <span
            class="rounded-full bg-muted px-2 py-1"
            data-testid="model-category-badge"
            data-part-category={definition.partCategory}
          >
            {categoryText}
          </span>
        )
      }
      {
        systemTagText && (
          <span data-testid="model-system-tag">{systemTagText}</span>
        )
      }
    </div>
  </div>
  <div
    class:list={[
      'flex min-w-0 flex-wrap items-center gap-2',
      { 'col-span-2 sm:col-start-2 sm:col-span-1': variant !== 'big' },
    ]}
  >
    <Button
      as="a"
      href={cadPath}
      variant="neon"
      size="sm"
      class="max-w-full whitespace-normal text-center no-underline"
      aria-label={t('models.editAria', { name: selectionLabel })}
    >
      {t('models.edit')}
    </Button>
    <ModelCardDialog
      {selectionLabel}
      {description}
      {dialogId}
      {cadPath}
      {parameterDetails}
      detailsLabel={t('models.details')}
      closeLabel={t('models.close')}
      parametersLabel={t('models.parameters')}
      exportLine={t('models.exportFormatsLine', {
        label: t('models.exportFormats'),
        value: t(exportFormatsLineKeyFor(definition)),
      })}
      {triggerClass}
    />
  </div>
</article>
