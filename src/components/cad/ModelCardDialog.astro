---
import { Separator } from '../starwind/separator'
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from '../starwind/dialog'

interface Props {
  selectionLabel: string
  description: string
  dialogId: string
  cadPath: string
  parameterDetails: string[]
  detailsLabel: string
  closeLabel: string
  parametersLabel: string
  exportLine: string
  triggerClass: string
}

const {
  selectionLabel,
  description,
  dialogId,
  cadPath,
  parameterDetails,
  detailsLabel,
  closeLabel,
  parametersLabel,
  exportLine,
  triggerClass,
} = Astro.props
---

<Dialog>
  <DialogTrigger
    class={triggerClass}
    data-model-details-open={dialogId}
    aria-controls={dialogId}
    hidden
  >
    {detailsLabel}
  </DialogTrigger>
  <a class={triggerClass} data-model-details-fallback href={cadPath}>
    {detailsLabel}
  </a>
  <DialogContent
    id={dialogId}
    class="max-h-[calc(100dvh-2rem)] w-[calc(100vw-2rem)] max-w-2xl overflow-hidden rounded-2xl border-border bg-card p-0 text-foreground"
    aria-labelledby={`${dialogId}-title`}
    data-testid="model-details-dialog"
    {closeLabel}
  >
    <div
      class="grid max-h-[calc(100dvh-2rem)] min-w-0 gap-5 overflow-y-auto p-5 sm:p-6"
      data-testid="model-details-scroll"
    >
      <DialogHeader class="min-w-0 items-start gap-0 text-left">
        <DialogTitle
          class="m-0 break-words text-2xl font-semibold leading-tight"
          id={`${dialogId}-title`}
        >
          {selectionLabel}
        </DialogTitle>
        <DialogDescription class="sr-only">{description}</DialogDescription>
      </DialogHeader>
      <Separator class="bg-border" />
      <section class="grid min-w-0 gap-2 text-sm leading-normal">
        <h3 class="m-0 text-lg font-semibold leading-tight">
          {parametersLabel}
        </h3>
        <ul
          class="m-0 grid list-none gap-0 overflow-hidden rounded-xl bg-muted p-0"
          data-testid="model-parameters-table"
        >
          {
            parameterDetails.map((summary) => (
              <li class="break-words border-b border-border px-4 py-2.5 font-mono text-sm leading-normal tabular-nums text-ink last:border-b-0">
                {summary}
              </li>
            ))
          }
        </ul>
        <p class="m-0 break-words text-muted-foreground">{exportLine}</p>
      </section>
    </div>
  </DialogContent>
</Dialog>
