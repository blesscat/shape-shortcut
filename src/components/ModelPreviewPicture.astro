---
type Props = {
  src: string
  darkSrc: string
  width: number
  height: number
  alt: string
  class?: string
  loading?: 'eager' | 'lazy'
  onerror?: string
}

const {
  src,
  darkSrc,
  width,
  height,
  alt,
  class: className,
  loading = 'lazy',
  onerror,
} = Astro.props

/**
 * Explicit root classes follow the header theme toggle. With JavaScript
 * disabled, the system preference applies when neither class is present.
 * The dark image is decorative; surrounding HTML provides the explanation.
 */
const lightClass = [className, 'preview-light'].filter(Boolean).join(' ')
const darkClass = [className, 'preview-dark'].filter(Boolean).join(' ')
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  class={lightClass}
  onerror={onerror}
/>

<style>
  .preview-dark {
    display: none;
  }

  :global(:root.dark) .preview-light {
    display: none;
  }

  :global(:root.dark) .preview-dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not(.light):not(.dark)) .preview-light {
      display: none;
    }

    :global(:root:not(.light):not(.dark)) .preview-dark {
      display: block;
    }
  }
</style>
<img
  src={darkSrc}
  alt=""
  aria-hidden="true"
  width={width}
  height={height}
  loading={loading}
  class={darkClass}
  onerror={onerror}
/>
