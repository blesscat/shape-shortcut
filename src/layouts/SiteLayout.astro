---
import '../styles/global.css'
import '@fontsource/nunito/latin-600.css'
import '@fontsource/nunito/latin-700.css'
import '@fontsource/nunito/latin-800.css'
import '@fontsource/nunito/latin-900.css'
import '@fontsource/noto-sans-tc/chinese-traditional-500.css'
import '@fontsource/noto-sans-tc/chinese-traditional-700.css'
import '@fontsource/noto-sans-tc/chinese-traditional-900.css'
import '@fontsource/jetbrains-mono/latin-400.css'
import '@fontsource/jetbrains-mono/latin-600.css'
import {
  supportProviders,
  type SupportProviderId,
} from '../features/support/config'
import { localeAlternatesFor, absoluteUrlFor } from '../i18n/seo'
import {
  localizedPathFor,
  publicPathFor,
  switchLocalePath,
  unlocalizedPathFor,
} from '../i18n/routes'
import { translate, type Locale } from '../i18n'
import Moon from '@tabler/icons/outline/moon.svg'
import Sun from '@tabler/icons/outline/sun.svg'

interface Props {
  locale: Locale
  title: string
  description?: string
  fullWidth?: boolean
}

const { locale, title, description, fullWidth = false } = Astro.props
const currentPath = Astro.url.pathname
const currentSearch = new URL(Astro.request.url).search
const routePath = unlocalizedPathFor(currentPath)
const isDocsPage = routePath === '/docs' || routePath.startsWith('/docs/')
const isHomePage = routePath === '/'
const isModelSelectionPage = routePath === '/models'
const isAboutPage = routePath === '/about' || routePath.startsWith('/about/')
const canonicalPath = localizedPathFor(locale, currentPath)
// System/view query parameters are UI state, not indexable page variants. Keep
// hreflang and canonical links on the stable localized route; the language-switch
// link below preserves the query for the user.
const alternateLinks = localeAlternatesFor(currentPath)
const alternateLocale = alternateLinks.find(
  (alternate) => alternate.locale !== locale,
)
const t = (key: string) => translate(locale, key)
const buildYear = new Date().getFullYear()
const supportCopyById: Record<
  SupportProviderId,
  { name: string; description: string; aria: string }
> = {
  portaly: {
    name: 'support.portalyName',
    description: 'support.portalyDescription',
    aria: 'support.portalyAria',
  },
  kofi: {
    name: 'support.kofiName',
    description: 'support.kofiDescription',
    aria: 'support.kofiAria',
  },
}
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="256x256" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={absoluteUrlFor(canonicalPath)} />
    {
      alternateLinks.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.locale}
          href={alternate.url}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={absoluteUrlFor(alternateLinks[0]?.path ?? canonicalPath)}
    />
    <script is:inline>
      ;(() => {
        const themeStorageKey = 'shape-shortcut-theme'
        const themeRoot = document.documentElement
        const themeMediaQuery =
          typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-color-scheme: dark)')
            : null

        const readStoredTheme = () => {
          try {
            const storedTheme = window.localStorage.getItem(themeStorageKey)
            return storedTheme === 'light' || storedTheme === 'dark'
              ? storedTheme
              : null
          } catch {
            return null
          }
        }

        const systemTheme = () => (themeMediaQuery?.matches ? 'dark' : 'light')

        const applyTheme = () => {
          const storedTheme = readStoredTheme()
          const theme = storedTheme ?? systemTheme()
          themeRoot.classList.toggle('dark', theme === 'dark')
          themeRoot.classList.toggle('light', storedTheme === 'light')
          themeRoot.style.colorScheme = theme
          return theme
        }

        const updateThemeToggle = (theme) => {
          const toggle = document.querySelector('[data-theme-toggle]')
          if (!(toggle instanceof HTMLButtonElement)) return

          const isDark = theme === 'dark'
          const nextLabel = isDark
            ? toggle.dataset.themeSwitchToLight
            : toggle.dataset.themeSwitchToDark
          if (nextLabel) toggle.setAttribute('aria-label', nextLabel)
          toggle.setAttribute('aria-pressed', String(isDark))

          const activeIcon = isDark ? 'light' : 'dark'
          for (const icon of toggle.querySelectorAll('[data-theme-icon]')) {
            if (icon instanceof HTMLElement) {
              icon.hidden = icon.dataset.themeIcon !== activeIcon
            }
          }

          const label = toggle.querySelector('[data-theme-toggle-label]')
          if (label instanceof HTMLElement) {
            label.textContent = isDark
              ? (toggle.dataset.themeLightLabel ?? '')
              : (toggle.dataset.themeDarkLabel ?? '')
          }
        }

        const syncTheme = () => updateThemeToggle(applyTheme())

        syncTheme()

        const handleSystemThemeChange = () => {
          if (readStoredTheme() === null) syncTheme()
        }
        if (typeof themeMediaQuery?.addEventListener === 'function') {
          themeMediaQuery.addEventListener('change', handleSystemThemeChange)
        } else {
          themeMediaQuery?.addListener?.(handleSystemThemeChange)
        }

        // The choice is per-browser, not per page: keep every already-open
        // tab in step when another tab stores a new theme, and re-apply
        // after back/forward restores a page from the bfcache (scripts do
        // not re-run on those restores).
        window.addEventListener('storage', (event) => {
          if (event.key === themeStorageKey || event.key === null) syncTheme()
        })
        window.addEventListener('pageshow', (event) => {
          if (event.persisted) syncTheme()
        })

        document.addEventListener('DOMContentLoaded', () => {
          const toggle = document.querySelector('[data-theme-toggle]')
          if (!(toggle instanceof HTMLButtonElement)) return

          syncTheme()
          toggle.addEventListener('click', () => {
            const nextTheme = applyTheme() === 'dark' ? 'light' : 'dark'
            try {
              window.localStorage.setItem(themeStorageKey, nextTheme)
            } catch {
              // Theme changes still apply for the current page if storage is unavailable.
            }
            syncTheme()
          })
        })
      })()
    </script>
  </head>
  <body>
    {
      /* The nav is a floating capsule in both themes; identical geometry keeps
        theme switches from shifting the page layout (CAD annotation boxes and
        viewport anchors must stay put). The scroll-collapsed compact state is
        driven by scroll position only, so both themes collapse in lockstep. */
    }
    <div class="min-h-screen pt-6">
      <nav
        class="group sticky top-0 z-40 mx-auto flex w-[90%] max-w-5xl flex-wrap items-center justify-between gap-x-4 gap-y-3 rounded-2xl border border-border bg-nav px-[clamp(1rem,4vw,4rem)] py-4 text-nav-foreground shadow-soft backdrop-blur-md transition-[padding-block,top] duration-200 ease-out motion-reduce:transition-none data-compact:py-1.5"
        aria-label={t('navigation.primary')}
        data-site-nav
      >
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <a
            class="font-mono font-semibold tracking-wide no-underline"
            href={publicPathFor(locale, 'home')}
            aria-current={isHomePage ? 'page' : undefined}>Shape Shortcut</a
          >
          <a
            class="font-mono text-sm tracking-wide no-underline group-data-compact:hidden"
            href={publicPathFor(locale, 'docs')}
            aria-current={isDocsPage ? 'page' : undefined}
            >{t('navigation.docs')}</a
          >
          <a
            class="font-mono text-sm tracking-wide no-underline group-data-compact:hidden"
            href={publicPathFor(locale, 'models')}
            aria-current={isModelSelectionPage ? 'page' : undefined}
            >{t('navigation.models')}</a
          >
          <a
            class="font-mono text-sm tracking-wide no-underline group-data-compact:hidden"
            href={publicPathFor(locale, 'about')}
            aria-current={isAboutPage ? 'page' : undefined}
            >{t('navigation.about')}</a
          >
        </div>
        <div class="flex flex-wrap items-center justify-end gap-x-3 gap-y-2">
          <button
            type="button"
            class="inline-flex size-11 items-center justify-center rounded-full border border-nav-foreground/40 bg-transparent no-underline transition-colors duration-200 hover:bg-nav-foreground/10 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus"
            data-theme-toggle
            data-theme-switch-to-light={t('navigation.switchToLight')}
            data-theme-switch-to-dark={t('navigation.switchToDark')}
            data-theme-light-label={t('navigation.light')}
            data-theme-dark-label={t('navigation.dark')}
            aria-label={t('navigation.theme')}
            aria-pressed="false"
          >
            <Sun class="size-4" data-theme-icon="light" aria-hidden="true" />
            <Moon
              class="size-4"
              data-theme-icon="dark"
              aria-hidden="true"
              hidden
            />
          </button>
          {
            alternateLocale && (
              <a
                class="no-underline"
                href={switchLocalePath(
                  currentPath,
                  currentSearch,
                  alternateLocale.locale,
                )}
                data-locale-switch
                aria-label={t('navigation.language')}
              >
                {translate(
                  locale,
                  alternateLocale.locale === 'en'
                    ? 'navigation.switchToEnglish'
                    : 'navigation.switchToZhHant',
                )}
              </a>
            )
          }
          {
            supportProviders.length > 0 && (
              <button
                type="button"
                class="inline-flex min-h-11 cursor-pointer items-center whitespace-nowrap rounded-full bg-primary-strong px-5 py-2 text-sm font-semibold text-white no-underline transition-[background-color,transform,box-shadow] duration-200 motion-safe:hover:-translate-y-0.5 motion-safe:hover:shadow-lift hover:bg-primary-hover focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus"
                data-support-dialog-open
                data-testid="support-trigger"
                aria-controls="support-dialog"
                aria-haspopup="dialog"
              >
                {t('navigation.support')}
              </button>
            )
          }
        </div>
      </nav>
      <script is:inline>
        ;(() => {
          const nav = document.querySelector('[data-site-nav]')
          if (!(nav instanceof HTMLElement)) return
          // Compact past 48px, relax only below 32px. The compact state
          // shrinks the capsule's padding and folds the secondary links,
          // so content below follows the capsule's height change.
          const syncCompactNav = () => {
            const isCompact = nav.hasAttribute('data-compact')
            const nextCompact =
              window.scrollY > 48 || (isCompact && window.scrollY >= 32)
            if (nextCompact !== isCompact) {
              nav.toggleAttribute('data-compact', nextCompact)
            }
          }

          syncCompactNav()
          window.addEventListener('scroll', syncCompactNav, { passive: true })
        })()
      </script>
      {
        supportProviders.length > 0 && (
          <dialog
            id="support-dialog"
            class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100vw-2rem)] max-w-xl overflow-hidden rounded-container border border-border bg-card p-0 text-card-foreground shadow-lift backdrop:bg-black/60"
            aria-labelledby="support-dialog-title"
            aria-describedby="support-dialog-description"
            data-testid="support-dialog"
          >
            <div class="grid max-h-[calc(100dvh-2rem)] min-w-0 gap-5 overflow-y-auto p-5 sm:p-6">
              <header class="flex min-w-0 items-start justify-between gap-4">
                <div class="min-w-0">
                  <h2
                    class="m-0 break-words text-2xl font-semibold leading-tight"
                    id="support-dialog-title"
                  >
                    {t('support.dialogTitle')}
                  </h2>
                  <p
                    class="m-0 mt-2 break-words text-sm leading-relaxed text-muted-foreground"
                    id="support-dialog-description"
                  >
                    {t('support.dialogDescription')}
                  </p>
                </div>
                <button
                  type="button"
                  class="inline-flex min-h-11 shrink-0 items-center rounded-full border border-border bg-background px-4 py-2 font-semibold text-foreground shadow-sm hover:bg-foreground/5 focus-visible:ring-3 focus-visible:ring-outline"
                  data-support-dialog-close
                  aria-label={t('support.close')}
                >
                  {t('support.close')}
                </button>
              </header>
              <div
                class="grid min-w-0 gap-3 sm:grid-cols-2"
                data-testid="support-provider-options"
              >
                {supportProviders.map((provider) => {
                  const copy = supportCopyById[provider.id]
                  return (
                    <a
                      class="grid min-w-0 gap-1 rounded-xl border border-border bg-background p-4 text-foreground no-underline shadow-sm transition-colors hover:bg-foreground/5 focus-visible:ring-3 focus-visible:ring-outline/50"
                      href={provider.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-support-provider={provider.id}
                      data-testid={`support-provider-${provider.id}`}
                      aria-label={t(copy.aria)}
                    >
                      <span class="font-semibold">{t(copy.name)}</span>
                      <span class="text-sm text-muted-foreground">
                        {t(copy.description)}
                      </span>
                    </a>
                  )
                })}
              </div>
            </div>
          </dialog>
        )
      }
      <script is:inline>
        for (const link of document.querySelectorAll('[data-locale-switch]')) {
          const url = new URL(link.href, window.location.href)
          if (window.location.search) {
            url.search = window.location.search
            link.href = url.pathname + url.search + url.hash
          }
        }
      </script>
      <main
        class:list={[
          'p-[clamp(1.5rem,4vw,4rem)]',
          !fullWidth && 'mx-auto max-w-[1200px]',
        ]}
      >
        <slot />
      </main>
      <footer
        class="border-t border-border bg-card px-[clamp(1rem,4vw,4rem)] py-8 text-sm text-muted-foreground"
        aria-label={t('navigation.footer')}
      >
        <div
          class="mx-auto flex w-full max-w-[1200px] flex-wrap items-center justify-between gap-x-6 gap-y-4"
        >
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="font-mono font-semibold tracking-wide text-foreground"
              >Shape Shortcut</span
            >
            <span>© {buildYear} Blesscat. All rights reserved.</span>
          </div>
          <div class="flex flex-wrap gap-x-4 gap-y-2">
            <a href={publicPathFor(locale, 'models')}
              >{t('navigation.models')}</a
            >
            <a href={publicPathFor(locale, 'docs')}>{t('navigation.docs')}</a>
            <a href={publicPathFor(locale, 'about')}>{t('navigation.about')}</a>
            <a
              class="font-mono"
              href="https://github.com/blesscat"
              target="_blank"
              rel="noopener noreferrer">{t('navigation.github')}</a
            >
            <a class="font-mono" href="mailto:blesscat@gmail.com"
              >{t('navigation.email')}</a
            >
          </div>
        </div>
      </footer>
      <script is:inline>
        const supportDialog = document.getElementById('support-dialog')
        const canUseSupportModal =
          typeof HTMLDialogElement !== 'undefined' &&
          supportDialog instanceof HTMLDialogElement &&
          typeof HTMLDialogElement.prototype.showModal === 'function'

        if (supportDialog instanceof HTMLElement) {
          let lastSupportOpener = null
          const restoreFocus = () => {
            if (lastSupportOpener instanceof HTMLElement) {
              lastSupportOpener.focus()
            }
            lastSupportOpener = null
          }
          const closeSupportDialog = () => {
            if (canUseSupportModal) {
              if (supportDialog.open) supportDialog.close()
              return
            }
            supportDialog.removeAttribute('open')
            restoreFocus()
          }

          for (const opener of document.querySelectorAll(
            '[data-support-dialog-open]',
          )) {
            if (!(opener instanceof HTMLElement)) continue
            opener.addEventListener('click', () => {
              lastSupportOpener = opener
              if (canUseSupportModal) {
                if (!supportDialog.open) supportDialog.showModal()
              } else {
                supportDialog.setAttribute('open', '')
              }
              supportDialog
                .querySelector('[data-support-dialog-close]')
                ?.focus()
            })
          }

          supportDialog.addEventListener('close', () => {
            restoreFocus()
          })
          supportDialog.addEventListener('click', (event) => {
            if (event.target === supportDialog) closeSupportDialog()
          })
          supportDialog.addEventListener('keydown', (event) => {
            if (!canUseSupportModal && event.key === 'Escape') {
              closeSupportDialog()
            }
          })

          for (const closeControl of supportDialog.querySelectorAll(
            '[data-support-dialog-close]',
          )) {
            closeControl.addEventListener('click', closeSupportDialog)
          }

          for (const providerLink of supportDialog.querySelectorAll(
            '[data-support-provider]',
          )) {
            providerLink.addEventListener('click', closeSupportDialog)
          }
        }
      </script>
      <style is:global>
        /* Warm capsule nav: the current page renders on the coral soft tint
           with deep coral text, in both appearances. */
        /* 44px hit areas on nav links in BOTH states; the compact fold is
           re-asserted here because this unlayered rule outranks the layered
           utility. */
        [data-site-nav] a {
          display: inline-flex;
          align-items: center;
          min-height: 44px;
        }
        [data-site-nav][data-compact] a.group-data-compact\:hidden {
          display: none;
        }
        [data-site-nav] a[aria-current='page'] {
          background-color: var(--color-primary-soft);
          color: var(--color-primary-hover);
          border-radius: 999px;
          padding-inline: 0.75rem;
          padding-block: 0.25rem;
        }
        :root.dark [data-site-nav] a[aria-current='page'] {
          color: var(--color-primary);
        }
        @media (prefers-color-scheme: dark) {
          :root:not(.light):not(.dark) [data-site-nav] a[aria-current='page'] {
            color: var(--color-primary);
          }
        }
      </style>
    </div>
  </body>
</html>
