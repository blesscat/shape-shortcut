{
  "name": "shape-shortcut",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{astro,svelte,css,scss,ts,tsx,js,jsx,mjs,cjs,json}\" \"scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"tests/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"*.{mjs,cjs,js,jsx,ts,tsx,json,yaml,yml,md}\" \".vscode/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{astro,svelte,css,scss,ts,tsx,js,jsx,mjs,cjs,json}\" \"scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"tests/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"*.{mjs,cjs,js,jsx,ts,tsx,json,yaml,yml,md}\" \".vscode/**/*.json\"",
    "test": "vitest run",
    "test:all": "vitest run",
    "test:changed": "node scripts/affected-tests.mjs changed",
    "test:branch": "node scripts/affected-tests.mjs branch",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "capture:model-previews": "CAPTURE_MODEL_PREVIEWS=1 playwright test tests/e2e/model-card-previews.spec.ts --project=chromium --workers=1",
    "verify:model-previews": "playwright test tests/e2e/model-card-previews.spec.ts --project=chromium --workers=1",
    "generate:desk-diagrams": "node scripts/desk-diagrams/generate.mjs",
    "verify:desk-diagrams": "node scripts/desk-diagrams/generate.mjs --check",
    "test:e2e:firefox": "xvfb-run -a env PW_HEADFUL=1 playwright test --project=firefox --headed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@starwind-ui/astro": "1.2.0",
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@threlte/core": "8.5.16",
    "@threlte/extras": "9.21.0",
    "astro": "^7.1.6",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "file:vendor/replicad-opencascadejs",
    "svelte": "5.56.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "4.1.1",
    "sass": "^1.102.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
